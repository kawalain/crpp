{
  "$schema": "../../schema/screen.offline.schema.json",
  "draw": [
    {"let": "text_w", "value": "dialog_width-2*dialog_pad_x"},
    {"let": "text_h", "value": "texth('paragraph', '@message', text_w)"},
    {"report": "width", "value": "dialog_width"},
    {"report": "height", "value": "dialog_pad_top+text_h+dialog_pad_bottom"},
    {"hit": "card", "group": []},
    {"text": "@message", "style": "paragraph", "color": "$ink", "x": "dialog_pad_x", "y": "dialog_pad_top", "w": "text_w", "h": "text_h"}
  ]
}
