{
  "$schema": "../../schema/screen.settings_display.schema.json",
  "draw": [
    {"id": "form", "y": 10, "column": [
      {"use": "form_group", "text": "#display_theme", "draw": [
        {"use": "form_check", "text": "#display_sync", "hit": "system_theme", "args": {"on": "@sync"}},
        {"if": "@sync", "use": "form_combo", "text": "#display_light", "after": 4, "draw": [{"slot": "light_list"}]},
        {"if": "@sync", "use": "form_combo", "text": "#display_dark", "after": 4, "draw": [{"slot": "dark_list"}]},
        {"if": "!@sync", "use": "form_combo", "text": "#display_general", "after": 4, "draw": [{"slot": "theme_list"}]},
        {"if": "@has_cursors", "use": "form_check", "text": "#display_theme_cursor", "hit": "theme_cursor", "args": {"on": "@theme_cursor"}}
      ]},
      {"use": "form_group", "text": "#room_word_chat", "draw": [
        {"let": "size", "value": "round(font_size*@percent/100)"},
        {"h": "2*(size+4)+12", "after": 8, "group": [
          {"use": "field"},
          {"text": "@sample_says", "style": "sample", "size": "size", "line_height": "size+4", "color": "$ink_soft", "x": 6, "y": 5, "w": "W-12", "h": "size+4"},
          {"text": "#display_chat_sample", "style": "sample", "size": "size", "line_height": "size+4", "color": "$ink", "x": 18, "y": "6+size+4", "w": "W-24", "h": "size+4"}
        ]},
        {"h": "18+field_h", "after": 6, "group": [
          {"use": "form_slider", "text": "#display_chat_size", "args": {"at": "(@percent-80)/70", "own": "hit('scale_slider')", "where": "note('slider')"}},
          {"text": "@percent_text", "style": "body_right", "color": "$ink_soft", "h": 16}
        ]}
      ]}
    ]},
    {"report": "height", "value": "form.bottom"}
  ]
}
