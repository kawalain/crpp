{
  "$schema": "../../schema/screen.emoji.schema.json",
  "draw": [
    {"let": "box_w", "value": 400},
    {"let": "box_h", "value": 306},
    {"let": "pad", "value": 14},
    {"let": "gap", "value": 4},
    {"let": "cols", "value": 8},
    {"let": "cell_size", "value": "(box_w-2*pad-(cols-1)*gap)/cols"},
    {"let": "step", "value": "cell_size+gap"},
    {"let": "rows", "value": "ceil(@count/cols)"},
    {"let": "view_h", "value": "box_h-2*pad"},
    {"let": "content_h", "value": "rows>0 ? rows*step-gap : 0"},
    {"report": "width", "value": "box_w"},
    {"report": "height", "value": "box_h"},
    {"report": "view", "value": "view_h"},
    {"report": "content", "value": "content_h"},
    {"hit": "backdrop", "group": []},
    {"x": "(W-box_w)/2", "y": "(H-box_h)/2", "w": "box_w", "h": "box_h", "group": [
      {"hit": "card", "group": []},
      // Only the rows in view are walked, so only they get parsed.
      {"let": "first", "value": "max(0, floor(@scroll/step))"},
      {"let": "last", "value": "min(rows-1, floor((@scroll+view_h)/step))"},
      {"report": "first", "value": "first*cols"},
      {"clip": true, "x": "pad", "y": "pad", "w": "box_w-2*pad", "h": "view_h", "group": [
        {"repeat": "min(@count-first*cols, (last-first+1)*cols)", "draw": [
          {"let": "n", "value": "first*cols+i"},
          {"let": "cell_x", "value": "(n-floor(n/cols)*cols)*step"},
          {"let": "cell_y", "value": "floor(n/cols)*step-@scroll"},
          {"use": "cell", "hit": "cell", "hit_index": "n", "x": "cell_x", "y": "cell_y", "w": "cell_size", "h": "cell_size", "args": {"selected": "@selected"}},
          {"picture": "cell", "x": "cell_x+(cell_size-32)/2", "y": "cell_y+(cell_size-32)/2", "w": 32, "h": 32}
        ]}
      ]},
      {"if": "@overflow", "note": "track", "hit": "track", "x": "W-12", "y": "pad", "w": 8, "h": "view_h", "group": []},
      {"let": "thumb_h", "value": "content_h>0 ? max(28, view_h*min(1, view_h/content_h)) : view_h"},
      {"if": "@overflow", "use": "plain_thumb", "hit": "thumb", "x": "W-12", "y": "pad+(view_h-thumb_h)*@offset/(content_h-view_h)", "w": 8, "h": "thumb_h"}
    ]}
  ]
}
