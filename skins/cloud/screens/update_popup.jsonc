{
  "$schema": "../../schema/screen.update_popup.schema.json",
  "draw": [
    // .update-popup: padding 10 12 10 16, gap 12, max-width: calc(100vw - 100px).
    {"let": "label_w", "value": "@has_label ? textw('update_label', '@label', W)+28 : 0"},
    {"let": "max_w", "value": "max(120, W-100)"},
    {"let": "chrome", "value": "28+(label_w>0 ? label_w+12 : 0)"},
    {"let": "room", "value": "max(40, max_w-chrome)"},
    {"let": "text_w", "value": "min(textw('update_text', '@text', room)+1, room)"},
    {"x": 14, "y": 14, "w": "text_w+chrome", "h": "(label_w>0 ? 32 : 22)+20", "group": [
      {"use": "panel_list"},
      {"hit": "card", "group": []},
      {"text": "@text", "style": "update_text", "color": "$hl_text", "x": 16, "y": "(H-22)/2", "w": "text_w", "h": 22},
      {"if": "label_w>0", "use": "button", "text": "@label", "hit": "button", "args": {"radius": 9, "grow": 1.03, "size": 15}, "x": "W-12-label_w", "y": 10, "w": "label_w", "h": 32}
    ]}
  ]
}
