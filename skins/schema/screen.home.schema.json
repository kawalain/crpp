{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen home of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @seats, @returning, @code_focus, @find_tip.\nTexts: @nickname, @greeting, @seat, @hello.\nHits: create, join, code, find, seat.\nPictures: my_emoji.\nFields: code.\nSlots: none.\nReports: none.\nNotes: none.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "enum": [
            "@nickname",
            "@greeting",
            "@seat",
            "@hello"
          ]
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "create",
            "join",
            "code",
            "find",
            "seat"
          ]
        },
        "note": false,
        "picture": {
          "enum": [
            "my_emoji"
          ]
        },
        "field": {
          "enum": [
            "code"
          ]
        },
        "slot": false,
        "report": false,
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
