{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen frame of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @active, @minimize, @close, @menu_shown, @open_menu.\nTexts: @title.\nHits: minimize, close, menu.\nPictures: droplet.\nFields: none.\nSlots: none.\nReports: none.\nNotes: menu_0, menu_1, menu_2.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "enum": [
            "@title"
          ]
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "minimize",
            "close",
            "menu"
          ]
        },
        "note": {
          "enum": [
            "menu_0",
            "menu_1",
            "menu_2"
          ]
        },
        "picture": {
          "enum": [
            "droplet"
          ]
        },
        "field": false,
        "slot": false,
        "report": false,
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
