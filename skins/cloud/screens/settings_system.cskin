text @tr.system_heading (9, 25, @W-9, 32) style heading color hl_text
use toggle(on = @autostart, hit = hit(autostart)) (16, 76, 505, 36) text @tr.system_autostart
use toggle(on = @tray, hit = hit(tray)) (16, 120, 505, 36) text @tr.system_tray
use toggle(on = @detail, hit = hit(detail)) (16, 164, 505, 36) text @tr.system_detail
text @tr.system_detail_hint (16, 164+28, 439, 60) style row_hint color hl_text_soft
// Where Skins come from (ADR 0008), which upstream does not have: the official one, which stays,
// and those the user added, each with the first digits of its key's fingerprint.
text @tr.system_repositories (9, 274, @W-9, 32) style heading color hl_text
text @tr.system_repositories_hint (16, 314, 505, 24) style row_hint color hl_text_soft
repeat @repositories {
  let top = 348+@i*58
  // The official one has no button, so its address may run to the end of the row. It opens the
  // Repository's page, underlined under the pointer as a link is.
  let address_w = min(textw(row_code, @repo_address), @repo_official>0 ? 505 : 355)
  hit open_repository (16, top, address_w, 26) {
    text @repo_address style row_code color @hot ? hl : hl_text
    fill hl (0, 20, address_w, 1) if @hot
  }
  slot fingerprint (16, top+26, 355, 20) styles (row_code_hint) colors (hl_text_soft, alpha(hl, 0.4))
  use text_button (381, top+4, 140, 38) text @tr.system_repository_remove hit remove_repository if @repo_official<1
}
let add_top = 348+@repositories*58+4
(16, add_top, 355, 38) {
  fill hl_pale radius 10
  hit address
  slot address (12, 6, 355-24, 26) styles (row_label) colors (hl_text, hl_text_soft, hl_text, alpha(hl, 0.4), hl_pale)
}
use text_button (381, add_top, 140, 38) text @tr.system_repository_add hit add_repository
text @repo_status (16, add_top+44, 505, 22) style row_hint color @repo_state>1 ? error_text : hl_text_soft if @repo_state>0
// The Skin Packs fetched from them, each with its size and where from, or why it stays.
let repositories_end = add_top+38+(@repo_state>0 ? 30 : 0)
let packs_top = repositories_end+24
text @tr.system_packs (12, packs_top, @W-12, 28) style subheading color @dark ? hl_text_dark : hl if @packs>0
repeat @packs {
  let top = packs_top+40+@i*58
  text @pack_name (16, top, 355, 26) style row_label color hl_text
  text @pack_detail (16, top+26, 355, 20) style row_hint color hl_text_soft
  use text_button (381, top+4, 140, 38) text @tr.system_pack_remove hit remove_pack if @pack_removable>0
  use text_button (381, top+4, 140, 38) text @tr.system_pack_update hit update_pack if @pack_held>0
}
// Time and language are on the display tab.
let advanced_top = (@packs>0 ? packs_top+40+@packs*58-12 : repositories_end)+36
text @tr.system_advanced (9, advanced_top, @W-9, 32) style heading color hl_text
// Which server to use, the default one unless another was checked and trusted.
let server_top = advanced_top+56
text @tr.system_server (16, server_top, 355, 26) style row_label color hl_text
(16, server_top+34, 355, 38) {
  fill hl_pale radius 10
  hit server
  slot server (12, 6, 355-24, 26) styles (row_code) colors (hl_text, hl_text_soft, hl_text, alpha(hl, 0.4), hl_pale)
}
use text_button (381, server_top+34, 140, 38) text @tr.system_server_apply hit apply_server
let server_status_h = texth(row_hint, @server_status, 505)
text @server_status (16, server_top+80, 505, server_status_h) style row_hint color @server_state>1 ? error_text : hl_text_soft
let release_top = server_top+80+server_status_h+28
text @tr.system_release (16, release_top, 300, 26) style row_label color hl_text
slot release_list (285, release_top-6, 246, 38)
text @tr.system_release_hint (16, release_top+36, 505, 20) style row_hint color hl_text_soft
use toggle(on = @logging, hit = hit(logging)) (16, release_top+63, 505, 36) text @tr.system_logging
use text_button (381, release_top+107, 140, 38) text @tr.system_open_logs hit open_logs if @logging
let reset_top = (@logging ? release_top+107+38 : release_top+63+36)+32
use text_button (381, reset_top, 140, 38) text @tr.system_reset hit reset
report height = reset_top+38+25
