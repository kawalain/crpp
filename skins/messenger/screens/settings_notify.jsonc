{
  "draw": [
    {"id": "form", "y": 10, "column": [
      {"use": "form_group", "text": "#notify_on_message", "draw": [
        {"use": "form_check", "text": "#notify_tray", "hit": "tray", "args": {"on": "@tray"}},
        {"use": "form_check", "text": "#notify_flash", "hit": "flash", "args": {"on": "@flash"}}
      ]},
      {"use": "form_group", "text": "#notify_sounds", "draw": [
        {"h": "@sounds*23", "repeat": "@sounds", "draw": [
          {"use": "form_check", "text": "@sound_name", "hit": "sound", "y": "i*23", "args": {"on": "@sound_on"}},
          {"use": "button", "text": "#notify_preview", "hit": "preview", "right": "W", "y": "i*23-1", "h": "button_h-1"}
        ]}
      ]}
    ]},
    {"report": "height", "value": "form.bottom"}
  ]
}
