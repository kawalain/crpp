{
  "draw": [
    {"let": "cap", "value": "snap(caption_h)"},
    {"let": "band", "value": "snap(frame_w)"},
    {"//": "The region keeps every pixel the curve touches. Those it only partly covers are blended with this, since a window cannot blend with what is behind it.",
     "fill": "@active ? $matte : $matte_idle", "w": "window_radius+1", "h": "window_radius+1"},
    {"fill": "@active ? $matte : $matte_idle", "x": "W-window_radius-1", "w": "window_radius+2", "h": "window_radius+1"},
    {"clip": true, "h": "cap", "group": [
      {"fill": "@active ? $caption : $caption_idle", "radius": "window_radius", "h": "cap+2*window_radius", "down_to": "cap"}
    ]},
    {"use": "frame_ring", "args": {"at": "2*u", "thick": "band-2*u", "top": "cap", "left": "@active ? $frame_in : $frame_idle", "right": "@active ? $frame_low_in : $frame_idle", "bottom": "@active ? $frame_low_in : $frame_idle"}},
    {"use": "frame_ring", "args": {"at": "u", "thick": "u", "top": "cap", "left": "@active ? $frame_mid : $frame_idle", "right": "@active ? $frame_low_mid : $frame_idle", "bottom": "@active ? $frame_low_mid : $frame_idle"}},
    {"use": "frame_ring", "args": {"at": 0, "thick": "u", "top": "cap", "left": "@active ? $frame_out : $frame_idle", "right": "@active ? $frame_low_out : $frame_idle", "bottom": "@active ? $frame_low_out : $frame_idle"}},

    {"picture": "droplet", "x": 8, "y": 6, "w": 16, "h": 16},
    {"let": "button_left", "value": "W-5-21"},
    {"let": "title_end", "value": "@minimize ? button_left-21-2 : @close ? button_left : W"},
    {"text": "@title", "style": "caption", "color": "$caption_shadow", "x": 29, "y": 1, "w": "max(0, title_end-32)", "h": "caption_h"},
    {"text": "@title", "style": "caption", "color": "$caption_ink", "x": 28, "w": "max(0, title_end-32)", "h": "caption_h"},
    {"if": "@minimize", "use": "caption_button", "hit": "minimize", "x": "button_left-21-2", "y": 4, "w": 21, "h": 21},
    {"if": "@close", "use": "caption_button", "hit": "close", "args": {"close": 1}, "x": "button_left", "y": 4, "w": 21, "h": 21},

    {"if": "@menu_shown", "x": "frame_w", "y": "caption_h", "w": "W-2*frame_w", "h": "menu_h", "group": [
      {"fill": "$face"},
      {"fill": "$edge_dark", "y": "H-1", "h": 1},
      {"use": "menu_title", "id": "one", "text": "#menu_file", "hit": "menu", "hit_index": 0, "note": "menu_0", "args": {"open": "@open_menu==0"}},
      {"use": "menu_title", "id": "two", "text": "#menu_tools", "hit": "menu", "hit_index": 1, "note": "menu_1", "args": {"open": "@open_menu==1"}, "x": "one.right"},
      {"use": "menu_title", "text": "#menu_help", "hit": "menu", "hit_index": 2, "note": "menu_2", "args": {"open": "@open_menu==2"}, "x": "two.right"}
    ]}
  ]
}
