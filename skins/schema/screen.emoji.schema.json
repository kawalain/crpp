{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen emoji of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @count, @offset, @scroll, @overflow, @selected.\nTexts: none.\nHits: backdrop, card, track, thumb, cell.\nPictures: cell.\nFields: none.\nSlots: none.\nReports: view, content, first, width, height.\nNotes: track.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "backdrop",
            "card",
            "track",
            "thumb",
            "cell"
          ]
        },
        "note": {
          "enum": [
            "track"
          ]
        },
        "picture": {
          "enum": [
            "cell"
          ]
        },
        "field": false,
        "slot": false,
        "report": {
          "enum": [
            "view",
            "content",
            "first",
            "width",
            "height"
          ]
        },
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
