{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen member_menu of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @self, @muted, @volume, @point_x, @point_y.\nTexts: @profile, @volume_label, @mute.\nHits: card, profile, slider, mute.\nPictures: none.\nFields: none.\nSlots: none.\nReports: none.\nNotes: track.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "enum": [
            "@profile",
            "@volume_label",
            "@mute"
          ]
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "card",
            "profile",
            "slider",
            "mute"
          ]
        },
        "note": {
          "enum": [
            "track"
          ]
        },
        "picture": false,
        "field": false,
        "slot": false,
        "report": false,
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
