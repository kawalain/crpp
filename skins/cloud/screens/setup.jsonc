{
  "$schema": "../../schema/screen.setup.schema.json",
  "draw": [
    {"let": "col_w", "value": "min(380, W-32)"},
    {"x": "(W-col_w)/2", "y": "H/2-60", "w": "col_w", "group": [
      {"text": "@message", "style": "setup_message", "color": "$ink_strong", "h": 26},
      {"use": "progress", "y": 46, "h": 8, "args": {"percent": "@percent"}},
      {"text": "@percent_text", "style": "setup_percent", "color": "$ink_strong", "y": 64, "h": 22}
    ]}
  ]
}
