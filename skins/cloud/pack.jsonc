{
  "$schema": "../schema/pack.schema.json",
  "format": 1,
  "id": "cloud",
  "themes": {
    "cloudroom": {"names": {"ko": "구름", "en": "Cloud"}, "dark": "darkcloud"},
    "pastel": {"names": {"ko": "파스텔", "en": "Pastel"}}
  },
  "default_theme": "cloudroom",
  "constants": {
    "own_frame": 0, "moves": 1,
    "list_pad": 6, "list_item_h": 38, "list_gap": 4, "list_max_h": 224, "list_margin": 6, "slider_thumb": 21
  },
  "palettes": {
    "cloudroom": {
      "white": "#ffffff",
      "blue": "#3a9af0",
      "hl": "#66ccff",
      "sky": "#66ccff",
      "hl_text": "#66ccff",
      "hl_soft": {"mix": ["hl", "white", 70]},
      "hl_dark": {"mix": ["hl", "blue", 88]},
      "hl_text_soft": {"mix": ["hl_text", "white", 65]},
      "hl_text_dark": {"mix": ["hl_text", "blue", 88]},
      "hl_pale": {"mix": ["hl", "white", 14]},
      "hl_pale2": {"mix": ["hl", "white", 28]},
      "hl_mid": {"mix": ["hl", "white", 55]},
      "surface": "#ffffff",
      "on_accent": "#ffffff",
      "tooltip_ink": "#ffffff",
      "droplet": "#ffffff",
      "entry": "#bbe1fd",
      "error_text": "#df7373",
      "ink_strong": "#2e5f80",
      "cloud_base": "#f3f9ff",
      "cloud_gradient": [[0, "#ffffff"], [1, "#eff8ff"]],
      "room_cloud": [[0, "#ffffff"], [0.42, "#f3f8fe"], [0.8, "#f1f8ff"], [1, "#e0eefb"]],
      "room_cloud_shadow": "#2f6f99",
      "fab_shadow": "#2e6498",
      "alarm": "#fa5462",
      "cloud_shadow": "#4f7b99",
      "backdrop": "#365669",
      "panel_shadow": "#2e78aa",
      "info_shadow": "#2e78aa",
      "hint_ink": "#94b8ca",
      "volume_tip": "#75ccff",
      "black": "#000000",
      "switch_off": "#cfe3ef",
      "toggle_off": "#cddfea",
      "version_ink": "#8a94a0",
      "tip_shadow": "#2e648c",
      "panel_cloud": "#f7fcff",
      "knob_shadow": "#608ba3"
    },
    "darkcloud": {
      "white": "#ffffff",
      "blue": "#3a9af0",
      "hl": "#4d7fab",
      "hl_dark": "#6393be",
      "hl_soft": "#3b5878",
      "hl_text": "#d0dfed",
      "hl_text_soft": "#a0b4c9",
      "hl_text_dark": "#ecf3fa",
      "hl_pale": "#293a50",
      "hl_pale2": "#344a63",
      "hl_mid": "#3c536e",
      "sky": "#101925",
      "surface": "#233145",
      "on_accent": "#eef5fb",
      "tooltip_ink": "#eef5fb",
      "droplet": "#27374c",
      "error_text": "#f39b9b",
      "entry": "#344a63",
      "ink_strong": "#ecf3fa",
      "cloud_base": "#27374c",
      "cloud_gradient": [[0, "#27374c"], [1, "#27374c"]],
      "room_cloud": [[0, "#27374c"], [1, "#27374c"]],
      "room_cloud_shadow": "#2f6f99",
      "fab_shadow": "#2e6498",
      "alarm": "#fa5462",
      "cloud_shadow": "#000000",
      "backdrop": "#365669",
      "panel_shadow": "#000000",
      "info_shadow": "#2e78aa",
      "hint_ink": "#a0b4c9",
      "volume_tip": "#75ccff",
      "black": "#000000",
      "switch_off": "#cfe3ef",
      "toggle_off": "#cddfea",
      "version_ink": "#8a94a0",
      "tip_shadow": "#2e648c",
      "panel_cloud": "#f7fcff",
      "knob_shadow": "#000000"
    },
    "pastel": {
      "white": "#ffffff",
      "blue": "#3a9af0",
      "hl": "#b1dafd",
      "sky": "#b1dafd",
      "hl_text": "#b1dafd",
      "hl_soft": {"mix": ["hl", "white", 70]},
      "hl_dark": {"mix": ["hl", "blue", 88]},
      "hl_text_soft": {"mix": ["hl_text", "white", 65]},
      "hl_text_dark": {"mix": ["hl_text", "blue", 88]},
      "hl_pale": {"mix": ["hl", "white", 14]},
      "hl_pale2": {"mix": ["hl", "white", 28]},
      "hl_mid": {"mix": ["hl", "white", 55]},
      "surface": "#ffffff",
      "on_accent": "#ffffff",
      "tooltip_ink": "#ffffff",
      "droplet": "#ffffff",
      "entry": "#bbe1fd",
      "error_text": "#df7373",
      "ink_strong": "#2e5f80",
      "cloud_base": "#f3f9ff",
      "cloud_gradient": [[0, "#ffffff"], [1, "#eff8ff"]],
      "room_cloud": [[0, "#ffffff"], [0.42, "#f3f8fe"], [0.8, "#f1f8ff"], [1, "#e0eefb"]],
      "room_cloud_shadow": "#2f6f99",
      "fab_shadow": "#2e6498",
      "alarm": "#fa5462",
      "cloud_shadow": "#4f7b99",
      "backdrop": "#365669",
      "panel_shadow": "#2e78aa",
      "info_shadow": "#2e78aa",
      "hint_ink": "#94b8ca",
      "volume_tip": "#75ccff",
      "black": "#000000",
      "switch_off": "#cfe3ef",
      "toggle_off": "#cddfea",
      "version_ink": "#8a94a0",
      "tip_shadow": "#2e648c",
      "panel_cloud": "#f7fcff",
      "knob_shadow": "#608ba3"
    }
  },
  "styles": {
    "plain": {"size": 16, "line_height": 0},
    "center": {"size": 16, "line_height": 0, "align": "center"},
    "code": {"size": 34, "line_height": 60, "letter_spacing": 2.72},
    "code_placeholder": {"size": 26, "line_height": 60},
    "tip": {"size": 16, "weight": 700, "line_height": 22, "align": "center"},
    "modal_text": {"size": 18, "weight": 700, "line_height": 27, "align": "center", "wrap": true},
    "dialog_text": {"size": 18, "weight": 700, "line_height": 27, "align": "center", "wrap": true, "keep_words": true},
    "button": {"size": 16, "weight": 700, "line_height": 0, "align": "center"},
    "toast_text": {"size": 15, "weight": 700, "line_height": 22, "wrap": true},
    "toast_action": {"size": 15, "weight": 700, "line_height": 32, "align": "center"},
    "bubble_text": {"size": 16, "weight": 700, "line_height": 22, "align": "center", "wrap": true},
    "tip_text": {"size": 16, "weight": 700, "line_height": 22, "align": "center", "wrap": true},
    "tip_small_text": {"size": 15, "weight": 700, "line_height": 22, "align": "center", "wrap": true},
    "tip_volume_text": {"size": 15, "line_height": 20, "align": "center", "wrap": true},
    "tip_measure": {"size": 16, "weight": 700, "line_height": 22},
    "tip_small_measure": {"size": 15, "weight": 700, "line_height": 22},
    "tip_volume_measure": {"size": 15, "line_height": 20},
    "notice_text": {"size": 16, "line_height": 23, "wrap": true},
    "notice_label": {"size": 15, "weight": 700, "line_height": 34, "align": "center"},
    "update_text": {"size": 15, "weight": 700, "line_height": 22, "ellipsis": true},
    "update_label": {"size": 15, "weight": 700, "line_height": 32, "align": "center"},
    "setup_message": {"size": 18, "weight": 700, "line_height": 26, "align": "center", "wrap": true},
    "setup_percent": {"size": 15, "line_height": 22, "align": "center"},
    "dropdown": {"size": 17, "weight": 700, "line_height": 0, "ellipsis": true},
    "list_item": {"size": 16, "line_height": 20, "ellipsis": true},
    "list_item_selected": {"size": 16, "weight": 700, "line_height": 20, "ellipsis": true},
    "prompt_heading": {"size": 28, "weight": 700, "line_height": 36, "align": "center"},
    "prompt_label": {"size": 17, "weight": 700, "line_height": 22},
    "prompt_input": {"size": 23, "line_height": 58},
    "prompt_hint": {"size": 14, "line_height": 21, "wrap": true},
    "prompt_button": {"size": 15, "line_height": 20, "align": "center"},
    "settings_tab": {"size": 20, "line_height": 37},
    "settings_tab_active": {"size": 20, "weight": 700, "line_height": 37},
    "version": {"size": 14, "line_height": 20, "align": "right"},
    "version_tip": {"size": 15, "weight": 700, "line_height": 32, "align": "center"},
    "droplet_tip": {"size": 16, "weight": 700, "line_height": 32, "align": "center"},
    "heading": {"size": 26, "weight": 700, "line_height": 32},
    "subheading": {"size": 21, "weight": 700, "line_height": 28},
    "row_label": {"size": 18, "line_height": 26},
    "row": {"size": 18, "line_height": 36},
    "row_hint": {"size": 14, "line_height": 20, "wrap": true},
    "text_button": {"size": 16, "line_height": 0, "align": "center"},
    "account_button": {"size": 17, "line_height": 0, "align": "center"},
    "slider_value": {"size": 15, "line_height": 26, "align": "center"},
    "slider_value_measure": {"size": 15, "line_height": 20},
    "balance_title": {"size": 16, "line_height": 24},
    "balance_word": {"size": 16, "weight": 700, "line_height": 24, "align": "right"},
    "balance_hint": {"size": 14, "line_height": 20},
    "person_me": {"size": 16, "weight": 700, "line_height": 20, "align": "center"},
    "sample_time": {"size": 14, "line_height": 20, "align": "right"},
    "sample_nick": {"size": 15, "line_height": 20, "ellipsis": true},
    "sample_text": {"size": 17, "line_height": 19},
    "preview_tip": {"size": 14, "weight": 700, "line_height": 26, "align": "center"},
    "preview_tip_measure": {"size": 14, "weight": 700, "line_height": 20},
    "account_nickname": {"size": 24, "weight": 700, "line_height": 30, "ellipsis": true},
    "account_handle": {"size": 16, "line_height": 20, "ellipsis": true},
    "account_display": {"size": 28, "weight": 700, "line_height": 34, "ellipsis": true},
    "account_tip": {"size": 16, "weight": 700, "line_height": 22, "align": "center"},
    "modal_button_measure": {"size": 16, "weight": 700, "line_height": 0},
    "member_name": {"size": 21, "weight": 700, "line_height": 26, "ellipsis": true},
    "room_label": {"size": 20, "weight": 700, "line_height": 41},
    "room_code": {"size": 20, "weight": 700, "line_height": 41, "align": "right", "letter_spacing": 0.4},
    "volume_text": {"size": 16, "weight": 700, "line_height": 22},
    "menu_item": {"size": 17, "weight": 700, "line_height": 22},
    "chat_input": {"size": 17, "line_height": 22, "wrap": true},
    "chat_body": {"size": 17, "line_height": 19, "wrap": true},
    "chat_time": {"size": 14, "line_height": 20, "align": "right"},
    "chat_nick": {"size": 15, "line_height": 20, "ellipsis": true},
    "calm": {"size": 34, "weight": 800, "line_height": "34*1.35"},
  },
  "parts": {
    // Upstream's cloud, set at this box's corner, with a soft shadow in the light Themes.
    "cloud": {
      "args": {"scale": 1, "shadow": 0, "sigma": 0},
      "draw": [
        {"if": "!dark", "path": "M388.527 317.44H101.915C54.679 317.44 16.386 279.073 16.386 231.744c0-42.356 30.678-77.512 70.979-84.436-.747-4.387-1.158-8.888-1.158-13.489 0-44 35.6-79.669 79.513-79.669 14.343 0 27.786 3.824 39.404 10.482C226.646 30.651 264.524 8.095 307.663 8.095c63.092 0 114.932 48.241 120.801 109.916 37.233 15.702 63.375 52.597 63.375 95.613 0 57.208-46.238 103.593-103.312 103.69Z", "color": "alpha($cloud_shadow, shadow)", "blur": "sigma*3", "dy": "6/scale", "scale": "scale"},
        {"path": "M388.527 317.44H101.915C54.679 317.44 16.386 279.073 16.386 231.744c0-42.356 30.678-77.512 70.979-84.436-.747-4.387-1.158-8.888-1.158-13.489 0-44 35.6-79.669 79.513-79.669 14.343 0 27.786 3.824 39.404 10.482C226.646 30.651 264.524 8.095 307.663 8.095c63.092 0 114.932 48.241 120.801 109.916 37.233 15.702 63.375 52.597 63.375 95.613 0 57.208-46.238 103.593-103.312 103.69Z", "color": "$cloud_base", "scale": "scale"},
        {"path": "M388.527 317.44H101.915C54.679 317.44 16.386 279.073 16.386 231.744c0-42.356 30.678-77.512 70.979-84.436-.747-4.387-1.158-8.888-1.158-13.489 0-44 35.6-79.669 79.513-79.669 14.343 0 27.786 3.824 39.404 10.482C226.646 30.651 264.524 8.095 307.663 8.095c63.092 0 114.932 48.241 120.801 109.916 37.233 15.702 63.375 52.597 63.375 95.613 0 57.208-46.238 103.593-103.312 103.69Z", "color": "$cloud_gradient", "scale": "scale", "from_y": 8, "to_y": 318}
      ]
    },
    // .tip: its box is the label's own, and it rises 4 px as it fades in.
    "tip": {
      "args": {"shown": 1},
      "draw": [
        {"fill": "alpha($hl, shown)", "radius": 11},
        {"text": "@label", "style": "tip", "color": "alpha($on_accent, shown)", "x": 15, "y": 5, "w": "W-29", "h": 22}
      ]
    },
    // .modal-backdrop's fade is a little shorter than the card's rise.
    "backdrop": {
      "args": {"shown": 1},
      "draw": [{"fill": "alpha($backdrop, 0.34*min(1, shown*160/140))"}]
    },
    // .modal-backdrop and .modal-card, in the window. What is in it goes in its box, and it rises 6 px.
    "modal": {
      "args": {"card_w": 320, "card_h": 100, "shown": 1, "backdrop": -1, "card": -1},
      "draw": [
        {"use": "backdrop", "args": {"shown": "shown"}},
        {"hit_by": "backdrop", "group": []},
        {"let": "left", "value": "(W-card_w)/2"},
        {"let": "top", "value": "(H-card_h)/2+6*(1-shown)"},
        {"shadow": "alpha($panel_shadow, (dark ? 0.33 : 0.22)*shown)", "x": "left", "y": "top", "w": "card_w", "h": "card_h", "radius": 14, "blur": "dark ? 38 : 16", "dy": "dark ? 12 : 4"},
        {"fill": "alpha($surface, shown)", "x": "left", "y": "top", "w": "card_w", "h": "card_h", "radius": 14},
        {"x": "left", "y": "(H-card_h)/2", "w": "card_w", "h": "card_h", "hit_by": "card", "group": []},
        {"x": "left", "y": "top", "w": "card_w", "h": "card_h", "group": [{"content": true}]}
      ]
    },
    // A panel whose shadow follows the dark Theme, as upstream's CSS has .modal-card and its lists.
    "panel_list": {
      "args": {"shown": 1},
      "draw": [
        {"shadow": "alpha($panel_shadow, (dark ? 0.33 : 0.22)*shown)", "radius": 14, "blur": "dark ? 38 : 16", "dy": "dark ? 12 : 4"},
        {"fill": "alpha($surface, shown)", "radius": 14}
      ]
    },
    "panel_modal": {
      "args": {"shown": 1},
      "draw": [{"use": "panel_list", "args": {"shown": "shown"}}]
    },
    // A message that floats over a screen.
    "bubble": {
      "args": {"shown": 1},
      "draw": [{"fill": "alpha($hl, shown)", "radius": 11}]
    },
    // One that keeps the light Theme's shadow in the dark one.
    "panel_info": {
      "args": {"shown": 1},
      "draw": [
        {"shadow": "alpha($info_shadow, 0.22*shown)", "radius": 14, "blur": 16, "dy": 4},
        {"fill": "alpha($surface, shown)", "radius": 14}
      ]
    },
    // .modal-confirm when primary, else .modal-cancel; other sizes for .update-button and a toast's.
    "button": {
      "args": {"primary": 1, "shown": 1, "radius": 10, "grow": 1.04, "size": 16},
      "draw": [
        {"scale": "hot ? grow : 1", "group": [
          {"fill": "alpha(primary ? (hot ? $hl_dark : $hl) : (hot ? $hl_soft : $hl_pale2), shown)", "radius": "radius"},
          {"text": "@label", "style": "button", "size": "size", "line_height": "H", "color": "alpha(primary || hot ? $on_accent : $hl_text, shown)"}
        ]}
      ]
    },
    "notice_button": {
      "args": {"primary": 1},
      "draw": [
        {"if": "primary", "fill": "hot ? $hl_dark : $hl", "radius": "H/2"},
        {"if": "!primary && hot", "fill": "$hl_pale", "radius": "H/2"},
        {"text": "@label", "style": "notice_label", "line_height": "H", "color": "primary ? $on_accent : $ink_strong"}
      ]
    },
    "prompt_button": {
      "draw": [
        {"scale": "hot ? 1.03 : 1", "group": [
          {"fill": "hot ? $hl_dark : $hl", "radius": 10},
          {"text": "@label", "style": "prompt_button", "color": "$on_accent", "y": 8, "h": 20}
        ]}
      ]
    },
    // The accent color is the sky's, so both parts are drawn in the surface color.
    "progress": {
      "args": {"percent": 0},
      "draw": [
        {"fill": "alpha($surface, 0.35)", "radius": 4},
        {"fill": "$surface", "radius": 4, "w": "max(H, W*percent/100)"}
      ]
    },
    "dropdown": {
      "args": {"open": 0, "off": 0},
      "draw": [
        {"let": "a", "value": "off ? 0.5 : 1"},
        {"fill": "alpha(open ? $hl_soft : hot ? $hl_dark : $hl, a)", "radius": 10},
        {"text": "@label", "style": "dropdown", "line_height": "H", "color": "alpha($on_accent, a)", "x": 12, "w": "W-48"},
        {"let": "cx", "value": "W-13-7"},
        {"let": "cy", "value": "H/2"},
        {"line": "alpha($white, a)", "x": "cx-6", "y": "cy-3", "x2": "cx", "y2": "cy+3", "width": 2},
        {"line": "alpha($white, a)", "x": "cx", "y": "cy+3", "x2": "cx+6", "y2": "cy-3", "width": 2}
      ]
    },
    "settings_tab": {
      "args": {"active": 0},
      "draw": [
        {"let": "lit_up", "to": "active", "first": "jump", "ms": 150},
        {"let": "over", "to": "hot", "first": "jump", "ms": 150},
        {"let": "grow", "to": "hot", "first": "jump", "ms": 140},
        {"let": "lit", "value": "max(lit_up, over)"},
        {"scale": "1+0.04*grow", "group": [
          {"if": "lit>0", "fill": "alpha(mix($hl, $hl_soft, lit_up*100), lit)", "radius": 9},
          {"if": "active", "text": "@label", "style": "settings_tab_active", "color": "mix($on_accent, $hl_text_soft, lit*100)", "x": 10, "w": "W-20"},
          {"if": "!active", "text": "@label", "style": "settings_tab", "color": "mix($on_accent, $hl_text_soft, lit*100)", "x": 10, "w": "W-20"}
        ]}
      ]
    },
    // .toggle-row: only the switch is clickable.
    "toggle": {
      "args": {"on": 0, "hit": -1},
      "draw": [
        {"text": "@label", "style": "row", "color": "$hl_text", "w": "W-50-16"},
        {"hit_by": "hit", "x": "W-50", "y": 5, "w": 50, "h": 26, "group": [
          {"let": "at", "to": "on", "first": "jump", "ms": 160},
          {"let": "shade", "to": "hot", "first": "jump", "ms": 150},
          {"fill": "mix($hl, dark ? $hl_pale2 : $toggle_off, at*100)", "radius": 13},
          {"if": "shade>0", "fill": "alpha($black, 0.05*shade)", "radius": 13},
          {"let": "cx", "value": "13+24*at"},
          // box-shadow: 0 1px 3px
          {"fill": "alpha($knob_shadow, 0.33*0.5)", "ellipse": true, "x": "cx-11", "y": 3, "w": 22, "h": 22},
          {"fill": "alpha($knob_shadow, 0.33)", "ellipse": true, "x": "cx-10.5", "y": 3.5, "w": 21, "h": 21},
          {"fill": "dark ? mix($on_accent, $hl_text_soft, at*100) : $surface", "ellipse": true, "x": "cx-10", "y": 3, "w": 20, "h": 20}
        ]}
      ]
    },
    "switch": {
      "args": {"on": 0, "off": 0, "ms": 160},
      "draw": [
        {"let": "a", "value": "off ? 0.5 : 1"},
        {"let": "at", "to": "on", "first": "jump", "ms": "ms"},
        {"let": "track", "value": "on ? $hl : (dark ? $hl_pale2 : $switch_off)"},
        {"fill": "alpha(hot && !off ? mix($black, track, 5) : track, a)", "radius": 14},
        {"fill": "alpha(dark ? (on ? $on_accent : $hl_text_soft) : $surface, a)", "ellipse": true, "x": "3+(W-H)*at", "y": 3, "w": "H-6", "h": "H-6"}
      ]
    },
    "slider": {
      "args": {"at": 0},
      "draw": [
        {"let": "pos", "value": "slider_thumb/2+(W-slider_thumb)*at"},
        {"fill": "$hl_pale2", "radius": 3, "y": "H/2-3", "h": 6},
        {"fill": "$hl", "radius": 3, "y": "H/2-3", "w": "pos", "h": 6},
        {"fill": "$hl", "ellipse": true, "x": "pos-slider_thumb/2", "y": "H/2-slider_thumb/2", "w": "slider_thumb", "h": "slider_thumb"},
        {"fill": "dark ? $hl_text_dark : $surface", "ellipse": true, "x": "pos-slider_thumb/2+2", "y": "H/2-slider_thumb/2+2", "w": "slider_thumb-4", "h": "slider_thumb-4"}
      ]
    },
    // .open-logs and .reset-settings: filled, grows a little under the pointer.
    "text_button": {
      "draw": [
        {"let": "over", "to": "hot", "first": "jump", "ms": 150},
        {"scale": "1+(1.03-1)*over", "group": [
          {"fill": "mix($hl_dark, $hl, over*100)", "radius": 8},
          {"text": "@label", "style": "text_button", "line_height": "H", "color": "$on_accent"}
        ]}
      ]
    },
    // .account-buttons
    "account_button": {
      "draw": [
        {"scale": "hot ? 1.03 : 1", "group": [
          {"fill": "hot ? $hl_dark : $hl", "radius": 8},
          {"text": "@label", "style": "account_button", "line_height": "H", "color": "$on_accent"}
        ]}
      ]
    },
    // .person: a head and a body, in its box of 46 by 62.
    "person": {
      "args": {"a": 1, "marked": 0},
      "draw": [
        {"let": "ink", "value": "alpha($hl, a)"},
        {"fill": "ink", "ellipse": true, "x": 9, "w": 28, "h": 28},
        {"path": "M0 23A23 23 0 0 1 46 23V33A4 4 0 0 1 42 37H4A4 4 0 0 1 0 33Z", "color": "ink", "y": 25},
        {"if": "marked", "text": "#sound_me", "style": "person_me", "color": "alpha($on_accent, a)", "y": 36, "h": 20}
      ]
    },
    // .fab, and what is in it in the middle of its box of 42.
    "fab": {
      "args": {"alarm": 0},
      "draw": [
        {"scale": "hot ? 1.08 : 1", "group": [
          {"shadow": "alpha($fab_shadow, 0.16)", "radius": 21, "blur": 8, "dy": 2},
          {"fill": "alarm ? $alarm : dark ? $cloud_base : $surface", "radius": 21},
          {"content": true}
        ]}
      ]
    },
    "menu_item": {
      "args": {"active": 0, "off": 0},
      "draw": [
        {"if": "active || hot", "fill": "active ? (hot ? $hl_dark : $hl) : $hl_soft", "radius": 9},
        {"text": "@label", "style": "menu_item", "color": "alpha(active || hot ? $on_accent : $hl_text, off ? 0.45 : 1)", "x": 12, "y": 8, "w": "W-24", "h": 22}
      ]
    },
    // li: padding 9 12, 20 tall.
    "list_item": {
      "args": {"selected": 0},
      "draw": [
        {"if": "selected", "fill": "$hl", "radius": 9},
        {"if": "!selected && hot", "fill": "$hl_soft", "radius": 9},
        {"if": "selected", "text": "@label", "style": "list_item_selected", "color": "$on_accent", "x": 12, "y": 9, "w": "W-24", "h": 20},
        {"if": "!selected", "text": "@label", "style": "list_item", "color": "hot ? $on_accent : $hl_text", "x": 12, "y": 9, "w": "W-24", "h": 20}
      ]
    }
  }
}
