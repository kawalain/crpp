{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen settings of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @page, @overflow, @view, @content, @offset, @has_version, @open, @scale, @window_x, @window_y, @window_w, @window_h, @tab_height, @scroll, @fade_top, @fade_bottom, @tab_changes, @selects, @left_scroll, @left_height, @left_fade_top, @left_fade_bottom, @bar_shown, @bar_over, @thumb_y, @thumb_h.\nTexts: @version.\nHits: overlay, droplet, thumb, version, track, bar_up, bar_down, tab.\nPictures: none.\nFields: none.\nSlots: tab, popups, current, leaving.\nReports: view, content.\nNotes: track, pane.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "enum": [
            "@version"
          ]
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "overlay",
            "droplet",
            "thumb",
            "version",
            "track",
            "bar_up",
            "bar_down",
            "tab"
          ]
        },
        "note": {
          "enum": [
            "track",
            "pane"
          ]
        },
        "picture": false,
        "field": false,
        "slot": {
          "enum": [
            "tab",
            "popups",
            "current",
            "leaving"
          ]
        },
        "report": {
          "enum": [
            "view",
            "content"
          ]
        },
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
