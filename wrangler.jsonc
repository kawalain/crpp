// The official Repository. The release script fills dist/repository with the signed catalog and
// the files it lists, then deploys with
//   npx --yes wrangler@4.152.0 deploy
// No package.json: the build has no package manager, so the version is pinned here and in
// the script instead. Authentication is the developer's own (CLOUDFLARE_API_TOKEN).
{
  "name": "crpp",
  "compatibility_date": "2026-11-08",
  // A file is served as a static asset without running this code; only a path that is no file,
  // the root included, reaches it, and it sends the visitor to the source repository.
  "main": "worker/redirect.js",
  // The address the program knows. A custom domain, so the Worker can move without a release.
  "routes": [{"pattern": "crpp.kawala.in", "custom_domain": true}],
  // Only that address: the workers.dev one is off, so there is one place to look.
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist/repository",
    // Paths are files, never pages: no trailing-slash redirects, and what is no file goes to `main`.
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
