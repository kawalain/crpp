{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen prompt of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @has_heading, @has_label, @has_prefix, @has_link, @has_extra, @has_extra2, @cancelable, @locked, @password, @shown, @hint_error, @busy, @submit_off.\nTexts: @heading, @label, @prefix, @hint, @extra2, @extra, @link.\nHits: field, submit, eye, back, extra, extra2, link.\nPictures: droplet.\nFields: none.\nSlots: field.\nReports: none.\nNotes: none.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "enum": [
            "@heading",
            "@label",
            "@prefix",
            "@hint",
            "@extra2",
            "@extra",
            "@link"
          ]
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "field",
            "submit",
            "eye",
            "back",
            "extra",
            "extra2",
            "link"
          ]
        },
        "note": false,
        "picture": {
          "enum": [
            "droplet"
          ]
        },
        "field": false,
        "slot": {
          "enum": [
            "field"
          ]
        },
        "report": false,
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
