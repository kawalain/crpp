{
  "$schema": "../../schema/screen.toast.schema.json",
  "draw": [
    {"let": "pad_x", "value": 10},
    {"let": "action_w", "value": "@has_action ? textw('button', '@action')+24 : 0"},
    {"let": "beside", "value": "action_w>0 ? action_w+10 : 0"},
    {"let": "text_max", "value": "max(40, W+2*frame_w-32-2*pad_x-beside)"},
    {"let": "text_w", "value": "textw('chat_text', '@text', text_max)"},
    {"let": "text_h", "value": "texth('chat_text', '@text', text_max)"},
    {"let": "card_w", "value": "text_w+2*pad_x+beside"},
    {"x": "(W-card_w)/2", "y": 8, "w": "card_w", "h": "max(text_h, action_w>0 ? button_h : 0)+14", "group": [
      {"use": "panel_info"},
      {"text": "@text", "style": "chat_text", "color": "$ink", "x": "pad_x", "y": "(H-text_h)/2", "w": "text_w+1", "h": "text_h"},
      {"if": "action_w>0", "use": "button", "text": "@action", "hit": "action", "x": "W-pad_x-action_w", "y": "(H-button_h)/2", "w": "action_w", "h": "button_h", "args": {"primary": 1}}
    ]}
  ]
}
