{
  "$schema": "../../schema/screen.notice.schema.json",
  "draw": [
    // Above the leave button, and leaving the chat input free.
    {"let": "card_w", "value": "min(380, W-32)"},
    {"let": "text_h", "value": "texth('notice_text', '@text', card_w-36)"},
    {"let": "card_h", "value": "18+text_h+14+34+18"},
    {"x": 16, "y": "H-72-card_h", "w": "card_w", "h": "card_h", "group": [
      {"use": "panel_info"},
      {"hit": "card", "group": []},
      {"text": "@text", "style": "notice_text", "color": "$ink_strong", "x": 18, "y": 18, "w": "W-36", "h": "text_h"},
      {"let": "action_w", "value": "@has_action ? textw('notice_label', '@action', W)+28 : 0"},
      {"let": "dismiss_w", "value": "textw('notice_label', '@dismiss', W)+28"},
      {"if": "@has_action", "use": "notice_button", "text": "@action", "hit": "action", "x": "W-18-action_w", "y": "H-18-34", "w": "action_w", "h": 34},
      {"use": "notice_button", "text": "@dismiss", "hit": "dismiss", "args": {"primary": "!@has_action"}, "x": "W-18-(@has_action ? action_w+6 : 0)-dismiss_w", "y": "H-18-34", "w": "dismiss_w", "h": 34}
    ]}
  ]
}
