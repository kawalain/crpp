{
  "$schema": "../../schema/screen.bubble.schema.json",
  "draw": [
    {"let": "text_w", "value": "textw('paragraph_center', '@text', 412)"},
    {"let": "text_h", "value": "texth('paragraph_center', '@text', 412)"},
    {"x": "@anchor_right-text_w-8", "y": "@anchor_y-@gap-text_h-4", "w": "text_w+8", "h": "text_h+4", "group": [
      {"use": "bubble"},
      {"text": "@text", "style": "paragraph_center", "color": "$tooltip_ink", "x": 4, "y": 2, "w": "W-8+1", "h": "text_h"}
    ]}
  ]
}
