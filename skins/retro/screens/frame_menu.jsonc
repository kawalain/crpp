{
  "$schema": "../../schema/screen.frame_menu.schema.json",
  "draw": [
    {"let": "menu_w", "value": 120},
    {"repeat": "@items", "draw": [
      {"set": "menu_w", "value": "max(menu_w, ceil(textw('body', '@item'))+40)"}
    ]},
    {"x": "@x", "y": "@y+1", "w": "menu_w", "h": "2+@items*22", "group": [
      {"use": "panel_menu"},
      {"repeat": "@items", "draw": [
        {"use": "menu_item", "text": "@item", "hit": "item", "hit_index": "@open*10+i", "x": 1, "y": "1+i*22", "w": "W-2", "h": 22}
      ]}
    ]}
  ]
}
