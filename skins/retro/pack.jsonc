{
  "$schema": "../schema/pack.schema.json",
  "format": 1,
  "id": "messenger",
  "constants": {
    "own_frame": 1, "moves": 0,
    "caption_h": 28, "frame_w": 3, "menu_h": 20, "window_radius": 8,
    "frame_edge": 4, "frame_corner": 12, "frame_button": 21, "frame_button_gap": 2, "frame_button_top": 4, "frame_button_right": 5,
    "window_home_w": 300, "window_home_h": 560, "window_home_min_w": 260, "window_home_min_h": 400,
    "window_room_w": 640, "window_room_h": 500, "window_room_min_w": 480, "window_room_min_h": 360,
    "window_prompt_w": 360, "window_prompt_h": 420, "window_prompt_min_w": 320, "window_prompt_min_h": 360,
    "window_options_w": 580, "window_options_h": 480, "window_options_min_w": 540, "window_options_min_h": 440,
    "window_changelog_w": 560, "window_changelog_h": 560, "window_changelog_min_w": 400, "window_changelog_min_h": 300,
    "button_w": 75, "button_h": 23, "field_h": 23, "check_size": 13, "row_h": 20, "scrollbar_w": 17,
    "dialog_pad_top": 14, "dialog_pad_x": 14, "dialog_pad_bottom": 12, "dialog_gap": 14, "dialog_button_h": 23, "dialog_button_w": 75,
    "dialog_button_gap": 6, "dialog_width": 280, "dialog_wide_width": 340, "dialog_margin": 16, "dialog_text_size": 16, "dialog_text_line": 18, "dialog_align": 0,
    "list_pad": 1, "list_item_h": 17, "list_gap": 0, "list_max_h": 138, "list_margin": 0, "slider_thumb": 21
  },
  "fonts": {
    // Gulim comes with an optional package of Windows; Malgun Gothic is always there.
    "korean": ["Gulim", "Malgun Gothic"], "other": ["Tahoma"], "caption": ["Trebuchet MS"],
    "korean_size": 12, "other_size": 11
  },
  "palettes": {
    "messenger": {
      "caption": [[0, "#0997ff"], [0.08, "#0053ee"], [0.4, "#0050ee"], [0.88, "#0066ff"], [0.93, "#0066ff"], [0.95, "#005bff"], [0.96, "#003dd7"], [1, "#003dd7"]],
      "caption_idle": [[0, "#a9c0f0"], [0.08, "#7a96df"], [0.4, "#7a96df"], [0.88, "#8aa7e4"], [0.93, "#8aa7e4"], [0.95, "#7d9ae0"], [0.96, "#6f8bd6"], [1, "#6f8bd6"]],
      "caption_ink": "#ffffff",
      "caption_shadow": "#0f1089",
      "frame_out": "#0831d9",
      "frame_mid": "#166aee",
      "frame_in": "#0855dd",
      "frame_low_out": "#00138c",
      "frame_low_mid": "#001ea0",
      "frame_low_in": "#0855dd",
      "close": [[0, "#e46142"], [1, "#dc451f"]],
      "close_hot": [[0, "#f08a70"], [1, "#e8603c"]],
      "caption_button": [[0, "#3c7ff0"], [1, "#1d4fd0"]],
      "caption_button_hot": [[0, "#6aa0f8"], [1, "#3468e4"]],
      "face": "#ece9d8",
      "field": "#ffffff",
      "field_line": "#7f9db9",
      "field_off": "#ece9d8",
      "edge_light": "#ffffff",
      "edge_dark": "#aca899",
      "edge_out": "#716f64",
      "button": [[0, "#ffffff"], [0.86, "#ecebe5"], [1, "#d8d0c4"]],
      "button_down": [[0, "#cdcac3"], [0.08, "#e3e3db"], [0.94, "#e5e5de"], [1, "#f2f2f1"]],
      "button_line": "#003c74",
      "hover_0": "#fff0cf",
      "hover_1": "#fdd889",
      "hover_2": "#fbc761",
      "hover_3": "#e5a01a",
      "focus_0": "#cee7ff",
      "focus_1": "#98b8ea",
      "focus_2": "#bcd4f6",
      "focus_3": "#89ade4",
      "off_ink": "#808080",
      "off_shadow": "#ffffff",
      "check_line": "#1d5281",
      "check_from": "#dcdcd7",
      "check_to": "#ffffff",
      "check_hot_0": "#f8b636",
      "check_hot_1": "#fedf9c",
      "tick": "#22a122",
      "track": "#ecebe4",
      "track_edge": "#9d9c99",
      "thumb_line": "#7f9db9",
      "thumb": [[0, "#ffffff"], [1, "#e3e1d2"]],
      "bar_thumb": "#c8d6fb",
      "bar_thumb_in": "#bad1fc",
      "bar_thumb_low": "#b7caf5",
      "bar_track_from": "#f3f1ec",
      "bar_track_to": "#fefefb",
      "bar_arrow": "#4d6185",
      "progress": [[0, "#acedad"], [0.17, "#7be47d"], [0.33, "#4cda50"], [0.5, "#2ed330"], [0.67, "#42d845"], [0.83, "#76e275"], [1, "#8fe791"]],
      "progress_line": "#686868",
      "group_line": "#d0d0bf",
      "legend": "#0046d5",
      "menu": "#ffffff",
      "menu_line": "#aca899",
      "select": "#316ac5",
      "select_ink": "#ffffff",
      "tooltip": "#ffffe1",
      "tooltip_line": "#000000",
      "tooltip_ink": "#000000",
      "header": [[0, "#eef3fc"], [1, "#c9d9f4"]],
      "info": [[0, "#e6eefb"], [1, "#c9daf5"]],
      "info_line": "#7f9db9",
      "glow_0": "#f8b636",
      "glow_1": "#fbc761",
      "glow_2": "#fedf9c",
      "ink": "#000000",
      "ink_soft": "#5a5a5a",
      "link": "#0046d5",
      "picture_line": "#7f9db9",
      "selection": "#316ac566",
      "black": "#000000",
      "gray": "#808080",
      "menu_shadow": {"alpha": ["black", 0.25]},
      "bar_thumb_hot": {"mix": ["bar_thumb", "edge_light", 50]},
      "toolbar_down": {"mix": ["face", "edge_dark", 60]},
      "check_shade_0": {"mix": ["check_from", "check_to", 60]},
      "check_shade_1": {"mix": ["check_from", "check_to", 40]},
      "check_shade_2": {"mix": ["check_from", "check_to", 20]},
      "list_line": {"mix": ["ink", "menu_line", 100]},
      "hl_soft": {"mix": ["select", "field", 35]},
      "hl_pale": {"mix": ["select", "field", 12]},
      "hl_pale2": {"mix": ["select", "field", 24]},
      "error_text": "#c00000",
      "matte": {"mix": ["frame_out", "gray", 50]},
      "matte_idle": {"mix": ["edge_dark", "gray", 50]},
      "frame_idle": {"mix": ["frame_in", "edge_light", 70]},
      "close_down": "#b8351a",
      "minimize_down": "#1740a8",
      "cursor_face": "#ffffff",
      "cursor_line": "#000000"
    },
    "messengerdark": {
      "caption": [[0, "#4a6491"], [0.08, "#1d2f52"], [0.4, "#1d2f52"], [0.88, "#253a63"], [0.93, "#253a63"], [0.95, "#1d2f52"], [0.96, "#142440"], [1, "#142440"]],
      "caption_idle": [[0, "#3a4252"], [0.08, "#2a303c"], [0.4, "#2a303c"], [0.88, "#303744"], [0.93, "#303744"], [0.95, "#2a303c"], [0.96, "#232833"], [1, "#232833"]],
      "caption_ink": "#f2f5fb",
      "caption_shadow": "#0a1222",
      "frame_out": "#142440",
      "frame_mid": "#2a4066",
      "frame_in": "#1d2f52",
      "frame_low_out": "#0c1628",
      "frame_low_mid": "#142440",
      "frame_low_in": "#1d2f52",
      "close": [[0, "#b4503a"], [1, "#96361f"]],
      "close_hot": [[0, "#d86c52"], [1, "#bc4a2e"]],
      "caption_button": [[0, "#3a5484"], [1, "#253a63"]],
      "caption_button_hot": [[0, "#54719f"], [1, "#365280"]],
      "face": "#232833",
      "field": "#12161f",
      "field_line": "#4b5a75",
      "field_off": "#1c212b",
      "edge_light": "#3b4252",
      "edge_dark": "#151922",
      "edge_out": "#0c0f15",
      "button": [[0, "#424a5c"], [0.86, "#333a49"], [1, "#282e3a"]],
      "button_down": [[0, "#1c212b"], [0.08, "#262c38"], [0.94, "#282e3a"], [1, "#323949"]],
      "button_line": "#0c1628",
      "hover_0": "#fff0cf",
      "hover_1": "#fdd889",
      "hover_2": "#fbc761",
      "hover_3": "#e5a01a",
      "focus_0": "#6d8fc4",
      "focus_1": "#4a6491",
      "focus_2": "#5a7aad",
      "focus_3": "#3f5880",
      "off_ink": "#6e7686",
      "off_shadow": "#151922",
      "check_line": "#6d8fc4",
      "check_from": "#1c212b",
      "check_to": "#12161f",
      "check_hot_0": "#f8b636",
      "check_hot_1": "#fedf9c",
      "tick": "#5cd65c",
      "track": "#3b4252",
      "track_edge": "#151922",
      "thumb_line": "#6d8fc4",
      "thumb": [[0, "#4a5266"], [1, "#333a49"]],
      "bar_thumb": "#3a4a68",
      "bar_thumb_in": "#34435f",
      "bar_thumb_low": "#2c3a53",
      "bar_track_from": "#1c212b",
      "bar_track_to": "#232833",
      "bar_arrow": "#c4cfe4",
      "progress": [[0, "#acedad"], [0.17, "#7be47d"], [0.33, "#4cda50"], [0.5, "#2ed330"], [0.67, "#42d845"], [0.83, "#76e275"], [1, "#8fe791"]],
      "progress_line": "#4b5a75",
      "group_line": "#3b4252",
      "legend": "#8db4f2",
      "menu": "#1c212b",
      "menu_line": "#3b4252",
      "select": "#3a68b4",
      "select_ink": "#ffffff",
      "tooltip": "#3d3a26",
      "tooltip_line": "#8c8660",
      "tooltip_ink": "#f5f1d8",
      "header": [[0, "#2c3546"], [1, "#232b3b"]],
      "info": [[0, "#2c3a53"], [1, "#233046"]],
      "info_line": "#4b5a75",
      "glow_0": "#f8b636",
      "glow_1": "#fbc761",
      "glow_2": "#fedf9c",
      "ink": "#e6ebf5",
      "ink_soft": "#a2adc2",
      "link": "#8db4f2",
      "picture_line": "#4b5a75",
      "selection": "#3a68b466",
      "black": "#000000",
      "gray": "#808080",
      "menu_shadow": {"alpha": ["black", 0.25]},
      "bar_thumb_hot": {"mix": ["bar_thumb", "edge_light", 50]},
      "toolbar_down": {"mix": ["face", "edge_dark", 60]},
      "check_shade_0": {"mix": ["check_from", "check_to", 60]},
      "check_shade_1": {"mix": ["check_from", "check_to", 40]},
      "check_shade_2": {"mix": ["check_from", "check_to", 20]},
      "list_line": {"mix": ["menu_line", "ink", 100]},
      "hl_soft": {"mix": ["select", "field", 35]},
      "hl_pale": {"mix": ["select", "field", 12]},
      "hl_pale2": {"mix": ["select", "field", 24]},
      "error_text": "#ff8f8f",
      "matte": {"mix": ["frame_out", "gray", 50]},
      "matte_idle": {"mix": ["edge_dark", "gray", 50]},
      "frame_idle": {"mix": ["frame_in", "edge_light", 70]},
      "close_down": "#b8351a",
      "minimize_down": "#1740a8",
      "cursor_face": "#ffffff",
      "cursor_line": "#000000"
    }
  },
  "styles": {
    "body": {"size": "font_size", "line_height": "h", "ellipsis": true, "exact": true},
    "body_center": {"size": "font_size", "line_height": "h", "align": "center", "ellipsis": true, "exact": true},
    "body_right": {"size": "font_size", "line_height": "h", "align": "right", "ellipsis": true, "exact": true},
    "bold": {"size": "font_size", "weight": 700, "line_height": "h", "ellipsis": true, "exact": true},
    "bold_center": {"size": "font_size", "weight": 700, "line_height": "h", "align": "center", "ellipsis": true, "exact": true},
    "button": {"size": "font_size", "line_height": "h", "align": "center", "ellipsis": true, "exact": true},
    "paragraph": {"size": "font_size", "line_height": "font_size+4", "wrap": true, "exact": true, "keep_words": true},
    "chat_text": {"size": "font_size", "line_height": "font_size+4", "wrap": true, "exact": true},
    "paragraph_center": {"size": "font_size", "line_height": "font_size+4", "align": "center", "wrap": true, "exact": true},
    "tip_line": {"size": "font_size", "line_height": 16, "exact": true},
    "note_title": {"size": "font_size+2", "weight": 700, "line_height": "font_size+4", "wrap": true, "exact": true},
    "note_version": {"size": "font_size", "line_height": 20, "exact": true},
    "title": {"size": "font_size+2", "weight": 700, "line_height": "h", "ellipsis": true, "exact": true},
    "sample": {"size": "font_size", "line_height": "font_size+4", "ellipsis": true, "exact": true},
    "caption": {"size": 13, "weight": 700, "line_height": "h", "ellipsis": true, "exact": true, "role": "caption"}
  },
  "parts": {
    "button": {
      "snap": true,
      "w": "max(75, ceil(textw('button', '@label'))+24)",
      "h": 23,
      "args": {"primary": 0, "focused": 0, "off": 0},
      "draw": [
        {"fill": "pressed && !off ? $button_down : $button", "radius": 3},
        {"if": "!off && !pressed && (hot || primary || focused)", "x": "u", "y": "u", "w": "W-2*u", "h": "H-2*u", "group": [
          {"fill": "hot ? $hover_0 : $focus_0", "h": "u"},
          {"fill": "hot ? $hover_1 : $focus_2", "y": "u", "h": "u"},
          {"fill": "hot ? $hover_2 : $focus_1", "y": "2*u", "w": "u", "h": "H-3*u"},
          {"fill": "hot ? $hover_2 : $focus_1", "x": "W-u", "y": "2*u", "w": "u", "h": "H-3*u"},
          {"fill": "hot ? $hover_3 : $focus_3", "y": "H-u", "h": "u"}
        ]},
        {"stroke": "off ? $edge_dark : $button_line", "radius": 3, "width": "u"},
        {"if": "off", "text": "@label", "style": "button", "color": "$off_shadow", "x": "u", "y": "u"},
        {"if": "off", "text": "@label", "style": "button", "color": "$off_ink"},
        {"if": "!off", "text": "@label", "style": "button", "color": "$ink", "x": "pressed ? u : 0", "y": "pressed ? u : 0"}
      ]
    },
    "toolbar_button": {
      "snap": true,
      "h": 24,
      "w": "ceil(textw('body', '@label'))+32",
      "args": {"lit": 0},
      "draw": [
        {"if": "pressed || lit", "fill": "$toolbar_down"},
        {"if": "hot || pressed || lit", "group": [
          {"fill": "pressed || lit ? $edge_dark : $edge_light", "h": "u"},
          {"fill": "pressed || lit ? $edge_dark : $edge_light", "w": "u"},
          {"fill": "pressed || lit ? $edge_light : $edge_dark", "y": "H-u", "h": "u"},
          {"fill": "pressed || lit ? $edge_light : $edge_dark", "x": "W-u", "w": "u"}
        ]},
        {"text": "@label", "style": "body", "color": "$ink", "x": "24+(pressed ? u : 0)", "y": "pressed ? u : 0", "w": "W-28"}
      ]
    },
    "field": {
      "args": {"off": 0},
      "draw": [
        {"fill": "off ? $field_off : $field"},
        {"frame": "$field_line"}
      ]
    },
    "check_box": {
      "snap": true,
      "w": 13,
      "h": 13,
      "args": {"on": 0, "off": 0},
      "draw": [
        {"x": "u", "y": "u", "w": "W-2*u", "h": "H-2*u", "group": [
          {"fill": "off ? $field_off : $check_to"},
          {"if": "!off", "fill": "$check_shade_0", "w": "W", "h": "u"},
          {"if": "!off", "fill": "$check_shade_0", "w": "u", "h": "H"},
          {"if": "!off", "fill": "$check_shade_1", "x": "u", "y": "u", "w": "W-u", "h": "u"},
          {"if": "!off", "fill": "$check_shade_1", "x": "u", "y": "u", "w": "u", "h": "H-u"},
          {"if": "!off", "fill": "$check_shade_2", "x": "2*u", "y": "2*u", "w": "W-2*u", "h": "u"},
          {"if": "!off", "fill": "$check_shade_2", "x": "2*u", "y": "2*u", "w": "u", "h": "H-2*u"}
        ]},
        {"frame": "off ? $edge_dark : $check_line"},
        {"if": "hot && !off", "frame": "$check_hot_0", "x": "u", "y": "u", "w": "W-2*u", "h": "H-2*u"},
        {"if": "hot && !off", "frame": "$check_hot_1", "x": "2*u", "y": "2*u", "w": "W-4*u", "h": "H-4*u"},
        {"if": "on", "path": "M3.5 6.5 5.5 8.5 9.5 4", "color": "off ? $off_ink : $tick", "width": 2, "caps": "flat"}
      ]
    },
    "combo_arrow": {
      "snap": true,
      "args": {"down": 0},
      "draw": [
        {"fill": "down ? $bar_thumb_low : hot ? $bar_thumb_hot : $bar_thumb", "radius": 2},
        {"stroke": "$edge_light", "radius": 2, "width": "u"},
        {"path": "M-4 -2H4L0 2.5Z", "color": "$bar_arrow", "x": "W/2", "y": "H/2", "w": 1, "h": 1, "snap": true}
      ]
    },
    "dropdown": {
      "args": {"open": 0, "off": 0},
      "draw": [
        {"use": "field", "args": {"off": "off"}},
        {"text": "@label", "style": "body", "color": "off ? $off_ink : $ink", "x": 4, "w": "W-24"},
        {"use": "combo_arrow", "args": {"down": "open"}, "x": "W-17", "y": 2, "w": 15, "h": "H-4"}
      ]
    },
    "picture_frame": {
      "snap": true,
      "args": {"glow": 0},
      "draw": [
        {"if": "glow > 0", "frame": "$glow_2", "alpha": "glow", "x": "-3*u", "y": "-3*u", "w": "W+6*u", "h": "H+6*u"},
        {"if": "glow > 0", "frame": "$glow_1", "alpha": "glow", "x": "-2*u", "y": "-2*u", "w": "W+4*u", "h": "H+4*u"},
        {"if": "glow > 0", "frame": "$glow_0", "alpha": "glow", "x": "-u", "y": "-u", "w": "W+2*u", "h": "H+2*u"},
        {"fill": "$field"},
        {"frame": "$picture_line"}
      ]
    },
    "group_box": {
      "snap": true,
      "draw": [
        {"stroke": "$group_line", "radius": 3, "width": "u"},
        {"let": "legend_w", "value": "ceil(textw('body', '@label'))+6"},
        {"fill": "$face", "x": 8, "y": -1, "w": "legend_w", "h": 3},
        {"text": "@label", "style": "body", "color": "$legend", "x": 11, "y": -8, "w": "legend_w", "h": 16}
      ]
    },
    "link": {
      "draw": [
        {"text": "@label", "style": "body", "color": "$link"},
        {"if": "hot", "fill": "$link", "y": "floor(Y+H/2+font_size/2)-Y", "w": "textw('body', '@label')", "h": 1}
      ]
    },
    "scroll_arrow": {
      "snap": true,
      "args": {"down": 0},
      "draw": [
        {"fill": "hot ? $bar_thumb_hot : $bar_thumb", "radius": 2},
        {"stroke": "$edge_light", "radius": 2, "width": "u"},
        {"if": "down", "path": "M-4 -2H4L0 2.5Z", "color": "$bar_arrow", "x": "W/2", "y": "H/2", "w": 1, "h": 1, "snap": true},
        {"if": "!down", "path": "M-4 2H4L0 -2.5Z", "color": "$bar_arrow", "x": "W/2", "y": "H/2", "w": 1, "h": 1, "snap": true}
      ]
    },
    "scroll_thumb": {
      "snap": true,
      "draw": [
        {"fill": "hot ? $bar_thumb_hot : $bar_thumb", "radius": 2},
        {"stroke": "$edge_light", "radius": 2, "width": "u"},
        {"let": "mid", "value": "snap(Y+H/2)-Y"},
        {"repeat": 4, "draw": [
          {"fill": "$edge_light", "x": 5, "y": "mid+(2*i-3)*u", "w": "W-10", "h": "u"},
          {"fill": "$bar_thumb_low", "x": 5, "y": "mid+(2*i-2)*u", "w": "W-10", "h": "u"}
        ]}
      ]
    },
    "scrollbar": {
      "args": {"view": 0, "content": 0, "offset": 0, "up": -1, "down": -1, "track": -1, "thumb": -1, "whole": 0, "track_note": -1},
      "draw": [
        {"let": "arrow_h", "value": "min(W, H/2)"},
        {"let": "track_h", "value": "H-2*arrow_h"},
        {"let": "room", "value": "content>view ? content-view : 0"},
        {"let": "thumb_h", "value": "content>0 ? max(16, floor(track_h*min(1, view/content))) : track_h"},
        {"let": "thumb_y", "value": "arrow_h+(room>0 ? floor((track_h-thumb_h)*offset/room) : 0)"},
        {"fill": "$bar_track_from", "y": "arrow_h", "h": "track_h", "note_by": "track_note"},
        {"hit_by": "track", "group": []},
        {"use": "scroll_arrow", "hit_by": "up", "live": "!whole", "h": "arrow_h"},
        {"use": "scroll_arrow", "hit_by": "down", "live": "!whole", "y": "H-arrow_h", "h": "arrow_h", "args": {"down": 1}},
        {"hit_by": "thumb", "y": "thumb_y", "h": "thumb_h", "group": [
          {"if": "track_h>=16 && thumb_h<track_h", "use": "scroll_thumb"}
        ]}
      ]
    },
    "check_row": {
      "args": {"on": 0, "off": 0, "pinned": 0},
      "draw": [
        {"use": "check_box", "y": 5, "args": {"on": "on", "off": "off"}},
        {"text": "@label", "style": "body", "color": "off ? $off_ink : $ink", "x": 18, "w": "W-30"},
        {"if": "pinned", "fill": "$link", "x": "W-7", "y": 9, "w": 6, "h": 6}
      ]
    },
    "plain_thumb": {
      "snap": true,
      "draw": [
        {"fill": "$bar_thumb", "radius": 2},
        {"stroke": "$edge_light", "radius": 2, "width": "u"}
      ]
    },
    "slider": {
      "args": {"at": 0},
      "draw": [
        {"let": "cy", "value": "snap(Y+H/2)-Y"},
        {"fill": "$track_edge", "y": "cy-u", "h": 1},
        {"fill": "$track", "y": "cy", "h": 1},
        {"fill": "$edge_light", "y": "cy+u", "h": 1},
        {"x": "10.5+(W-21)*at-5", "y": "cy-9", "w": 11, "h": 19, "snap": true, "group": [
          {"fill": "$thumb", "radius": 2},
          {"fill": "$tick", "x": "u", "y": "u", "w": "W-2*u", "h": "2*u"},
          {"fill": "$tick", "x": "u", "y": "H-3*u", "w": "W-2*u", "h": "2*u"},
          {"stroke": "$thumb_line", "radius": 2, "width": "u"}
        ]}
      ]
    },
    "switch": {
      "args": {"on": 0, "off": 0},
      "draw": [
        {"use": "check_box", "args": {"on": "on", "off": "off"}, "y": "floor(Y+(H-13)/2)-Y"}
      ]
    },
    "progress": {
      "args": {"percent": 0},
      "draw": [
        {"y": "H/2-7", "h": 14, "snap": true, "group": [
          {"fill": "$field"},
          {"frame": "$progress_line"},
          {"let": "inner", "value": "W-4"},
          {"let": "filled", "value": "inner*percent/100"},
          {"repeat": "min(floor(filled/10)+1, ceil(inner/10))", "draw": [
            {"fill": "$progress", "x": "2+i*10", "y": 2, "w": "min(8, inner-i*10)", "h": "H-4", "snap": true}
          ]}
        ]}
      ]
    },
    "bubble": {
      "snap": true,
      "draw": [
        {"fill": "$tooltip"},
        {"frame": "$tooltip_line"}
      ]
    },
    "cell": {
      "args": {"selected": 0},
      "draw": [
        {"if": "selected", "fill": "$hl_soft"},
        {"if": "selected || hot", "frame": "$select"}
      ]
    },
    "list_item": {
      "args": {"selected": 0},
      "draw": [
        {"if": "selected || hot", "fill": "$select"},
        {"text": "@label", "style": "body", "color": "selected || hot ? $select_ink : $ink", "x": 3, "w": "W-6"}
      ]
    },
    "menu_item": {
      "args": {"active": 0, "off": 0},
      "draw": [
        {"if": "hot", "fill": "$select"},
        {"text": "@label", "style": "body", "color": "off ? $off_ink : hot ? $select_ink : $ink", "x": 20, "w": "W-24"},
        {"if": "active", "path": "M3.5 6.5 5.5 8.5 9.5 4", "color": "off ? $off_ink : hot ? $select_ink : $ink", "x": 2, "y": "round(Y+(H-13)/2)-Y", "width": 2, "caps": "flat"}
      ]
    },
    "panel_modal": {"draw": [{"fill": "$face"}]},
    "panel_list": {"draw": [{"fill": "$field"}, {"frame": "$list_line"}]},
    "panel_menu": {"draw": [
      {"fill": "$menu_shadow", "x": 2, "y": 2},
      {"fill": "$menu"},
      {"frame": "$menu_line"}
    ]},
    "panel_popup": {"snap": true, "draw": [
      {"fill": "$face"},
      {"frame": "$edge_out"},
      {"fill": "$edge_light", "x": "u", "y": "u", "w": "W-2*u", "h": "u"},
      {"fill": "$edge_light", "x": "u", "y": "u", "w": "u", "h": "H-2*u"},
      {"fill": "$edge_dark", "x": "u", "y": "H-2*u", "w": "W-2*u", "h": "u"},
      {"fill": "$edge_dark", "x": "W-2*u", "y": "u", "w": "u", "h": "H-2*u"}
    ]},
    "panel_info": {"draw": [{"fill": "$info"}, {"frame": "$info_line"}]},
    "form_group": {
      "height": "rows.bottom+20",
      "draw": [
        {"id": "rows", "x": 12, "y": 14, "w": "W-24", "column": [{"content": true}]},
        {"use": "group_box", "text": "@label", "x": 2, "w": "W-4", "h": "rows.bottom+6"}
      ]
    },
    "form_check": {
      "h": "row_h",
      "args": {"on": 0, "off": 0},
      "draw": [
        {"use": "check_box", "y": 3, "args": {"on": "on", "off": "off"}},
        {"text": "@label", "style": "body", "color": "off ? $off_ink : $ink", "x": 18, "w": "W-18"}
      ]
    },
    "form_text": {
      "h": "texth('paragraph', '@label', W)",
      "draw": [{"text": "@label", "style": "paragraph", "color": "$ink_soft"}]
    },
    "form_hint": {
      "h": "texth('paragraph', '@label', W-18)",
      "draw": [{"text": "@label", "style": "paragraph", "color": "$ink_soft"}]
    },
    "form_combo": {
      "h": "field_h",
      "draw": [
        {"let": "list_w", "value": "min(170, floor(W*0.55))"},
        {"text": "@label", "style": "body", "color": "$ink", "w": "W-list_w-6"},
        {"x": "W-list_w", "w": "list_w", "group": [{"content": true}]}
      ]
    },
    "form_slider": {
      "h": "18+field_h",
      "args": {"at": 0, "list": 0, "own": -1, "where": -1},
      "draw": [
        {"text": "@label", "style": "body", "color": "$ink", "h": 16},
        {"let": "list_w", "value": "list ? floor(W*0.52) : 0"},
        {"use": "slider", "hit_by": "own", "note_by": "where", "y": 18, "w": "W-(list ? list_w+8 : 0)", "h": "field_h", "args": {"at": "at"}},
        {"if": "list", "x": "W-list_w", "y": 18, "w": "list_w", "h": "field_h", "group": [{"content": true}]}
      ]
    },
    "options_tab": {
      "args": {"active": 0},
      "draw": [
        {"if": "active", "fill": "$select"},
        {"if": "!active && hot", "fill": "$hl_pale2"},
        {"text": "@label", "style": "body", "color": "active ? $select_ink : $ink", "x": 6, "w": "W-12"}
      ]
    },
    "frame_ring": {
      "args": {"at": 0, "thick": 0, "top": 0, "left": 0, "right": 0, "bottom": 0},
      "draw": [
        {"fill": "left", "x": "at", "y": "top", "w": "thick", "h": "H-top-at"},
        {"fill": "right", "x": "W-at-thick", "y": "top", "w": "thick", "h": "H-top-at"},
        {"fill": "bottom", "x": "at", "y": "H-at-thick", "w": "W-2*at", "h": "thick"}
      ]
    },
    "menu_title": {
      "w": "ceil(textw('body_center', '@label'))+14",
      "h": "menu_h-1",
      "args": {"open": 0},
      "draw": [
        {"if": "open || hot", "fill": "$select"},
        {"text": "@label", "style": "body_center", "color": "open || hot ? $select_ink : $ink"}
      ]
    },
    "caption_button": {
      "snap": true,
      "args": {"close": 0},
      "draw": [
        {"if": "pressed", "fill": "close ? $close_down : $minimize_down", "radius": 3},
        {"if": "!pressed", "fill": "close ? (hot ? $close_hot : $close) : (hot ? $caption_button_hot : $caption_button)", "radius": 3},
        {"stroke": "$caption_ink", "radius": 3, "width": "u"},
        {"if": "close", "line": "$caption_ink", "x": "W*0.3", "y": "W*0.3", "x2": "W-W*0.3", "y2": "H-W*0.3", "width": 2},
        {"if": "close", "line": "$caption_ink", "x": "W-W*0.3", "y": "W*0.3", "x2": "W*0.3", "y2": "H-W*0.3", "width": 2},
        {"if": "!close", "fill": "$caption_ink", "x": "W*0.25", "y": "H-H*0.34", "w": "W*0.38", "h": 3}
      ]
    },
    // The pointer, drawn here on a grid of whole pixels after the white arrow of the time. Both Palettes have the same two colours.
