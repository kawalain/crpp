{
  "$schema": "../../schema/screen.dropdown.schema.json",
  "draw": [
    {"let": "content_h", "value": "@items*(list_item_h+list_gap)-list_gap+2*list_pad"},
    {"let": "list_h", "value": "min(content_h, list_max_h)"},
    {"report": "view", "value": "list_h"},
    {"report": "content", "value": "content_h"},
    {"note": "list", "y": "@up ? -list_margin-list_h : H+list_margin", "h": "list_h", "group": [
      {"use": "panel_list"},
      {"clip": true, "group": [
        {"repeat": "@items", "draw": [
          {"if": "@heading", "use": "list_heading", "text": "@item", "x": "list_pad", "y": "list_pad-@scroll+i*(list_item_h+list_gap)", "w": "W-2*list_pad", "h": "list_item_h"},
          {"if": "!@heading", "use": "list_item", "text": "@item", "hit": "item", "hit_index": "i", "x": "list_pad", "y": "list_pad-@scroll+i*(list_item_h+list_gap)", "w": "W-2*list_pad", "h": "list_item_h", "args": {"selected": "@selected"}}
        ]}
      ]}
    ]}
  ]
}
