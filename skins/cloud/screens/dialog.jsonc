{
  "$schema": "../../schema/screen.dialog.schema.json",
  "draw": [
    {"let": "shown", "to": 1, "again": "@revision", "ms": 160},
    {"let": "card_w", "value": "min(@wide ? 380 : 320, W-40)"},
    {"let": "text_h", "value": "texth('dialog_text', '@text', card_w-50)"},
    {"let": "card_h", "value": "24+text_h+20+38+20"},
    {"report": "width", "value": "card_w"},
    {"report": "height", "value": "card_h"},
    {"use": "modal", "args": {"card_w": "card_w", "card_h": "card_h", "shown": "shown", "backdrop_hit": "hit('backdrop')", "card_hit": "hit('card')"}, "draw": [
      {"text": "@text", "style": "dialog_text", "color": "alpha($hl_text, shown)", "x": 25, "y": 24, "w": "W-50", "h": "text_h"},
      {"let": "left", "value": "(W-(@has_cancel ? 2*96+10 : 96))/2"},
      {"use": "button", "text": "@confirm", "hit": "confirm", "args": {"shown": "shown"}, "x": "left", "y": "H-20-38", "w": 96, "h": 38},
      {"if": "@has_cancel", "use": "button", "text": "@cancel", "hit": "cancel", "args": {"primary": 0, "shown": "shown"}, "x": "left+96+10", "y": "H-20-38", "w": 96, "h": 38}
    ]}
  ]
}
