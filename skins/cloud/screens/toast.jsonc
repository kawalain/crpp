{
  "$schema": "../../schema/screen.toast.schema.json",
  "draw": [
    // It slides from above the window to 8 below its top (translate(-50%, -150%)).
    {"report": "ms", "value": 180},
    {"let": "shown", "to": "@up", "ms": 180},
    {"let": "max_w", "value": "W-32"},
    {"let": "action_w", "value": "@has_action ? textw('toast_action', '@action', max_w)+26 : 0"},
    {"let": "beside", "value": "action_w>0 ? action_w+16 : 0"},
    {"let": "text_max", "value": "max(40, max_w-36-beside)"},
    {"let": "text_w", "value": "textw('toast_text', '@text', text_max)"},
    {"let": "text_h", "value": "texth('toast_text', '@text', text_max)"},
    {"let": "card_w", "value": "text_w+36+beside"},
    {"let": "card_h", "value": "max(text_h, action_w>0 ? 32 : 0)+22"},
    {"x": "(W-card_w)/2", "y": "8-(card_h*1.5+8)*(1-shown)", "w": "card_w", "h": "card_h", "group": [
      {"use": "panel_info", "args": {"shown": "shown"}},
      {"text": "@text", "style": "toast_text", "color": "alpha($hl_text, shown)", "x": 18, "y": "(H-text_h)/2", "w": "text_w+1", "h": "text_h"},
      {"if": "action_w>0", "use": "button", "text": "@action", "hit": "action", "args": {"shown": "shown", "radius": 8, "grow": 1, "size": 15}, "x": "W-18-action_w", "y": "(H-32)/2", "w": "action_w", "h": 32}
    ]}
  ]
}
