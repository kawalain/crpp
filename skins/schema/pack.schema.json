{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pack.jsonc of a Skin Pack",
  "description": "A Skin Pack's Palettes, styles and parts. Its screens are files of their own, under screens/.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "format",
    "id"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": 1,
      "description": "What the pack is written for; an exe that reads another number refuses it."
    },
    "id": {
      "type": "string",
      "description": "The name of the pack, in lower case."
    },
    "names": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "What the user calls this Skin, by locale id."
    },
    "extends": {
      "type": "string",
      "description": "The id of the pack this one starts from. What this names replaces what that has by the same name."
    },
    "themes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "names"
        ],
        "additionalProperties": false,
        "properties": {
          "names": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "What the user sees, by locale id."
          },
          "palette": {
            "type": "string",
            "description": "Its Palette, when that is not named as the Theme is."
          },
          "dark": {
            "type": "string",
            "description": "The Palette of its dark variant. Without this it has none."
          },
          "overlay": {
            "type": "string",
            "description": "The folder under overlays/ it needs on top of the pack."
          }
        }
      },
      "description": "What a user can pick in this Skin. The pack holds only the Palettes of the Themes of one overlay at a time."
    },
    "default_theme": {
      "type": "string",
      "description": "The Theme this Skin goes to when it is picked."
    },
    "constants": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "description": "Names for numbers, anywhere in the pack. The program reads the ones this requires."
    },
    "fonts": {
      "type": "object",
      "required": [
        "korean",
        "other",
        "caption",
        "korean_size",
        "other_size"
      ],
      "additionalProperties": false,
      "properties": {
        "korean": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Installed fonts, the first this system has: for Korean, and for every Hangul letter."
        },
        "other": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "The same, for the other languages."
        },
        "caption": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "The same, for a style of role caption."
        },
        "korean_size": {
          "type": "number",
          "description": "font_size in Korean."
        },
        "other_size": {
          "type": "number",
          "description": "font_size in the other languages."
        }
      },
      "description": "The fonts of the time, fitted to whole pixels. Without this the program uses its own font."
    },
    "cursors": {
      "type": "object",
      "properties": {
        "arrow": {
          "type": "object",
          "required": [
            "part",
            "hot"
          ],
          "additionalProperties": false,
          "properties": {
            "part": {
              "type": "string",
              "description": "A part that draws it in a box of 32 by 32."
            },
            "hot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "The point that clicks, in that box."
            }
          }
        },
        "hand": {
          "type": "object",
          "required": [
            "part",
            "hot"
          ],
          "additionalProperties": false,
          "properties": {
            "part": {
              "type": "string",
              "description": "A part that draws it in a box of 32 by 32."
            },
            "hot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "The point that clicks, in that box."
            }
          }
        },
        "ibeam": {
          "type": "object",
          "required": [
            "part",
            "hot"
          ],
          "additionalProperties": false,
          "properties": {
            "part": {
              "type": "string",
              "description": "A part that draws it in a box of 32 by 32."
            },
            "hot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "The point that clicks, in that box."
            }
          }
        },
        "size_we": {
          "type": "object",
          "required": [
            "part",
            "hot"
          ],
          "additionalProperties": false,
          "properties": {
            "part": {
              "type": "string",
              "description": "A part that draws it in a box of 32 by 32."
            },
            "hot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "The point that clicks, in that box."
            }
          }
        },
        "size_ns": {
          "type": "object",
          "required": [
            "part",
            "hot"
          ],
          "additionalProperties": false,
          "properties": {
            "part": {
              "type": "string",
              "description": "A part that draws it in a box of 32 by 32."
            },
            "hot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "The point that clicks, in that box."
            }
          }
        },
        "size_nwse": {
          "type": "object",
          "required": [
            "part",
            "hot"
          ],
          "additionalProperties": false,
          "properties": {
            "part": {
              "type": "string",
              "description": "A part that draws it in a box of 32 by 32."
            },
            "hot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "The point that clicks, in that box."
            }
          }
        },
        "size_nesw": {
          "type": "object",
          "required": [
            "part",
            "hot"
          ],
          "additionalProperties": false,
          "properties": {
            "part": {
              "type": "string",
              "description": "A part that draws it in a box of 32 by 32."
            },
            "hot": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2,
              "description": "The point that clicks, in that box."
            }
          }
        },
        "hard": {
          "type": "boolean",
          "description": "Hard edges in that box, then enlarged by whole pixels, so the steps of the grid show at any scale."
        }
      },
      "required": [
        "arrow",
        "hand",
        "ibeam",
        "size_we",
        "size_ns",
        "size_nwse",
        "size_nesw"
      ],
      "additionalProperties": false,
      "description": "The pointer in this pack's windows, all of it or none. Without this it is the system's."
    },
    "palettes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/palette"
      },
      "description": "By the names themes gives them, or one per Theme without themes. Those of one overlay have the same entries."
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/style"
      },
      "description": "Text styles."
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/part"
      },
      "description": "Controls that screens use. A part can only use parts above it, unless the pack extends another or has an overlay, and knows nothing of screens."
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "#rrggbb or #rrggbbaa."
    },
    "palette": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/color"
          },
          {
            "type": "array",
            "items": {
              "type": "array",
              "items": [
                {
                  "type": "number"
                },
                {
                  "$ref": "#/definitions/color"
                }
              ],
              "minItems": 2,
              "maxItems": 2
            },
            "minItems": 2,
            "maxItems": 16,
            "description": "A gradient, as [[at, colour], ...]."
          },
          {
            "type": "object",
            "description": "[a, b, percent of a], of entries above it.",
            "required": [
              "mix"
            ],
            "additionalProperties": false,
            "properties": {
              "mix": {
                "type": "array",
                "items": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          {
            "type": "object",
            "description": "[a, alpha], of an entry above it.",
            "required": [
              "alpha"
            ],
            "additionalProperties": false,
            "properties": {
              "alpha": {
                "type": "array",
                "items": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        ]
      },
      "properties": {
        "extends": {
          "type": "string",
          "description": "Another Palette, whose entries this one starts from."
        }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "size",
        "line_height"
      ],
      "additionalProperties": false,
      "properties": {
        "size": {
          "$ref": "common.schema.json#/definitions/expression",
          "description": "Worked out for each node using it, in that node's box."
        },
        "line_height": {
          "$ref": "common.schema.json#/definitions/expression",
          "description": "Worked out for each node using it, in that node's box."
        },
        "weight": {
          "type": "integer",
          "minimum": 100,
          "maximum": 900
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "role": {
          "enum": [
            "body",
            "caption"
          ],
          "description": "Which of the Skin's fonts."
        },
        "letter_spacing": {
          "type": "number"
        },
        "wrap": {
          "type": "boolean"
        },
        "ellipsis": {
          "type": "boolean"
        },
        "exact": {
          "type": "boolean",
          "description": "The size means pixels, not a kind of text."
        },
        "keep_words": {
          "type": "boolean",
          "description": "A line breaks only between words."
        }
      }
    },
    "part": {
      "type": "object",
      "required": [
        "draw"
      ],
      "additionalProperties": false,
      "properties": {
        "snap": {
          "type": "boolean",
          "description": "Its box moves to whole pixels."
        },
        "w": {
          "$ref": "common.schema.json#/definitions/expression",
          "description": "Its width where a use says none. It may read @label."
        },
        "h": {
          "$ref": "common.schema.json#/definitions/expression",
          "description": "Its height where a use says none. It may read @label."
        },
        "height": {
          "$ref": "common.schema.json#/definitions/expression",
          "description": "Worked out after it has drawn, from its own names: the height it took in a column."
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/definitions/expression"
          },
          "description": "Its arguments, with what they are when a use says nothing."
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    },
    "text": {
      "anyOf": [
        {
          "const": "@label"
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": false,
        "note": false,
        "picture": false,
        "field": false,
        "slot": false,
        "report": false,
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
