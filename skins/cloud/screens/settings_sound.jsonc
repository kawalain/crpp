{
  "$schema": "../../schema/screen.settings_sound.schema.json",
  "draw": [
    // Vertical positions are main.js settingsContent's. Without the Pen row everything below it moves up.
    {"let": "pen_shift", "value": "@show_pen ? 0 : 69"},
    {"let": "effects_shift", "value": "104-pen_shift"},
    {"let": "balance_top", "value": "749+effects_shift"},
    {"let": "reverb_top", "value": "balance_top+60+16"},
    {"text": "#sound_speaker", "style": "heading", "color": "$hl_text", "x": 9, "y": 25, "w": 500, "h": 32},
    {"text": "#sound_devices", "style": "heading", "color": "$hl_text", "x": 9, "y": 167, "w": 500, "h": 32},
    {"text": "#sound_effects", "style": "heading", "color": "$hl_text", "x": 9, "y": "535+effects_shift", "w": 500, "h": 32},

    {"text": "#sound_speaker_volume", "style": "row_label", "color": "$hl_text", "x": 16, "y": 68, "w": 300, "h": 26},
    {"use": "slider", "hit": "speaker_volume", "note": "slider_0", "x": 16, "y": "102+7-21/2", "w": 244, "h": 21, "args": {"at": "@speaker_volume/100"}},
    {"slot": "speaker_list", "x": 285, "y": 75, "w": 246, "h": 38},
    {"text": "#sound_keyboard_volume", "style": "row_label", "color": "$hl_text", "x": 16, "y": 214, "w": 300, "h": 26},
    {"use": "slider", "hit": "keyboard_volume", "note": "slider_1", "x": 16, "y": "249+7-21/2", "w": 244, "h": 21, "args": {"at": "@keyboard_volume/100"}},
    {"slot": "keyboard_list", "x": 285, "y": 220.5, "w": 246, "h": 38},
    {"text": "#sound_mouse_volume", "style": "row_label", "color": "$hl_text", "x": 16, "y": 283, "w": 300, "h": 26},
    {"use": "slider", "hit": "mouse_volume", "note": "slider_2", "x": 16, "y": "318+7-21/2", "w": 244, "h": 21, "args": {"at": "@mouse_volume/100"}},
    {"slot": "mouse_list", "x": 285, "y": 290, "w": 246, "h": 38},
    {"if": "@show_pen", "text": "#sound_pen_volume", "style": "row_label", "color": "$hl_text", "x": 16, "y": 352, "w": 300, "h": 26},
    {"if": "@show_pen", "use": "slider", "hit": "pen_volume", "note": "slider_3", "x": 16, "y": "387+7-21/2", "w": 244, "h": 21, "args": {"at": "@pen_volume/100"}},
    {"if": "@show_pen", "slot": "pen_list", "x": 285, "y": 360, "w": 246, "h": 38},
    {"text": "#sound_listen_self", "style": "row", "color": "$hl_text", "x": 16, "y": "424-pen_shift", "w": 445, "h": 36},
    {"use": "switch", "hit": "listen_self", "x": 471, "y": "424-pen_shift+5", "w": 50, "h": 26, "args": {"on": "@listen_self"}},
    {"text": "#sound_others_use_mine", "style": "row", "color": "$hl_text", "x": 16, "y": "476-pen_shift", "w": 445, "h": 36},
    {"use": "switch", "hit": "others_use_mine", "x": 471, "y": "476-pen_shift+5", "w": 50, "h": 26, "args": {"on": "@others_use_mine"}},
    {"text": "#sound_mute_notifications", "style": "row", "color": "$hl_text", "x": 16, "y": "528-pen_shift", "w": 445, "h": 36},
    {"use": "switch", "hit": "mute_notifications", "x": 471, "y": "528-pen_shift+5", "w": 50, "h": 26, "args": {"on": "@mute_notifications"}},
    {"text": "#sound_mute_on_idle", "style": "row", "color": "$hl_text", "x": 16, "y": "580-pen_shift", "w": 445, "h": 36},
    {"use": "switch", "hit": "mute_on_idle", "x": 471, "y": "580-pen_shift+5", "w": 50, "h": 26, "args": {"on": "@mute_on_idle"}},
    {"text": "#sound_spatial", "style": "row", "color": "$hl_text", "x": 16, "y": "581+effects_shift", "w": 445, "h": 36},
    {"use": "switch", "hit": "spatial", "x": 471, "y": "581+effects_shift+5", "w": 50, "h": 26, "args": {"on": "@spatial"}},
    {"text": "#sound_balance_enabled", "style": "row", "color": "alpha($hl_text, !@spatial ? 0.42 : 1)", "x": 16, "y": "633+effects_shift", "w": 445, "h": 36},
    {"use": "switch", "hit": "balance_enabled", "live": "!!@spatial", "hit_if": "!!@spatial", "x": 471, "y": "633+effects_shift+5", "w": 50, "h": 26, "args": {"on": "@balance_enabled", "off": "!@spatial"}},

    // .balance-control: 385 wide, centered in the 550 column, 60 high, with a person on each side of the slider.
    // Without the surround every Desk is centred, so it would change nothing.
    {"let": "a", "value": "@balance_on ? 1 : 0.42"},
    {"text": "#sound_balance", "style": "balance_title", "color": "alpha($hl_text, a)", "x": 16, "y": "687+effects_shift", "w": 505, "h": 24},
    {"text": "@balance_word", "style": "balance_word", "color": "alpha($hl_text, a)", "x": 16, "y": "687+effects_shift", "w": 505, "h": 24},
    {"text": "#sound_balance_hint", "style": "balance_hint", "color": "alpha($hl_text, a*0.75)", "x": 16, "y": "687+effects_shift+24", "w": 505, "h": 20},
    {"use": "person", "x": 82.5, "y": "balance_top-1", "w": 46, "h": 62, "args": {"a": "a", "marked": 1}},
    {"use": "person", "x": "138.5+273+10", "y": "balance_top-1", "w": 46, "h": 62, "args": {"a": "a"}},
    {"let": "ratio", "value": "(@balance-55)/35"},
    {"hit": "balance", "hit_if": "@balance_on", "x": 138.5, "y": "balance_top+(60-39)/2", "w": 273, "h": 39, "group": [
      {"let": "thumb_w", "value": "29.15"},
      {"fill": "alpha($hl_pale2, a)", "radius": 3, "x": "thumb_w/2", "y": "H/2-3", "w": "W-thumb_w", "h": 6},
      {"if": "ratio>0", "fill": "alpha($hl, a)", "radius": 3, "x": "thumb_w/2", "y": "H/2-3", "w": "(W-thumb_w)*ratio", "h": 6},
      // The thumb's mask, viewBox -9.8 0 349.8 468.
      {"path": "M305.1,287.000 C295.016,299.989 282.766,313.682 265.1,315.000 C251.730,316.122 255.120,296.759 263.000,289.000 C272.380,279.765 279.802,242.670 271.000,217.000 C262.198,191.330 230.460,157.326 192.1,149.1 L192.1,335.793 C193.345,336.601 193.706,337.398 194.028,338.222 C212.363,385.188 185.104,439.707 133.143,459.993 C81.182,480.278 24.195,458.649 5.859,411.683 C-12.477,364.717 14.782,310.198 66.744,289.913 C91.239,280.350 116.847,280.109 138.1,287.439 L138.1,8.1 C138.1,4.029 143.029,-0.000 148.000,-0.000 L192.1,1.1 C192.1,1.1 261.344,50.059 289.1,76.000 C325.180,107.847 333.327,134.014 339.000,166.000 C344.600,197.570 325.823,263.557 305.1,287.000 Z", "color": "alpha($hl, a)", "x": "ratio*(W-thumb_w)+9.8*(thumb_w/349.8)", "scale": "thumb_w/349.8"},
      // Where the program finds a value along it, for a thumb of its own size.
      {"note": "balance", "x": "thumb_w/2-slider_thumb/2", "w": "W-thumb_w+slider_thumb", "group": []}
    ]},

    {"text": "#sound_reverb", "style": "row", "color": "$hl_text", "x": 16, "y": "reverb_top", "w": 505, "h": 36},
    {"slot": "reverb_list", "x": 285, "y": "reverb_top+(36-38)/2", "w": 246, "h": 38},
    {"report": "height", "value": "reverb_top+36+25"}
  ]
}
