{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen changelog of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @has_entries, @has_tagline, @has_date, @has_version, @shown_hint, @overflow, @view, @content, @offset.\nTexts: @tagline, @date, @version, @hint.\nHits: card, bar_track, bar_thumb.\nPictures: none.\nFields: none.\nSlots: body.\nReports: none.\nNotes: bar_track.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "enum": [
            "@tagline",
            "@date",
            "@version",
            "@hint"
          ]
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "card",
            "bar_track",
            "bar_thumb"
          ]
        },
        "note": {
          "enum": [
            "bar_track"
          ]
        },
        "picture": false,
        "field": false,
        "slot": {
          "enum": [
            "body"
          ]
        },
        "report": false,
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
