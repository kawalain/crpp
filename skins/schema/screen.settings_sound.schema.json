{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen settings_sound of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @speaker_volume, @keyboard_volume, @mouse_volume, @pen_volume, @show_pen, @listen_self, @others_use_mine, @mute_notifications, @mute_on_idle, @spatial, @balance_enabled, @balance_on, @balance.\nTexts: @balance_word.\nHits: speaker_volume, keyboard_volume, mouse_volume, pen_volume, listen_self, others_use_mine, mute_notifications, mute_on_idle, spatial, balance_enabled, balance.\nPictures: none.\nFields: none.\nSlots: speaker_list, keyboard_list, mouse_list, pen_list, reverb_list.\nReports: height.\nNotes: slider_0, slider_1, slider_2, slider_3, balance.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "enum": [
            "@balance_word"
          ]
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "speaker_volume",
            "keyboard_volume",
            "mouse_volume",
            "pen_volume",
            "listen_self",
            "others_use_mine",
            "mute_notifications",
            "mute_on_idle",
            "spatial",
            "balance_enabled",
            "balance"
          ]
        },
        "note": {
          "enum": [
            "slider_0",
            "slider_1",
            "slider_2",
            "slider_3",
            "balance"
          ]
        },
        "picture": false,
        "field": false,
        "slot": {
          "enum": [
            "speaker_list",
            "keyboard_list",
            "mouse_list",
            "pen_list",
            "reverb_list"
          ]
        },
        "report": {
          "enum": [
            "height"
          ]
        },
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
