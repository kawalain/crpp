    "node_shape": {
      "type": "object",
      "description": "One thing to draw, chosen by which of fill, frame, stroke, line, path, text, picture, field, slot, group, column, use, content, repeat, let, set or report it has.",
      "properties": {
        "if": {
          "$ref": "#/definitions/expression",
          "description": "Draw this only when it is not 0. Its id then reads as zeros."
        },
        "id": {
          "type": "string",
          "description": "A name for its box: siblings further on read id.x, .y, .w, .h, .right and .bottom."
        },
        "x": {
          "$ref": "#/definitions/expression",
          "description": "From the left of the box around it. 0 when left out."
        },
        "right": {
          "$ref": "#/definitions/expression",
          "description": "Where its right edge goes, instead of x."
        },
        "y": {
          "$ref": "#/definitions/expression",
          "description": "From the top of the box around it. 0 when left out, or flow in a column."
        },
        "bottom": {
          "$ref": "#/definitions/expression",
          "description": "Where its bottom edge goes, instead of y."
        },
        "w": {
          "$ref": "#/definitions/expression",
          "description": "Its width. The box around it, or a part's own w, when left out."
        },
        "h": {
          "$ref": "#/definitions/expression",
          "description": "Its height. The box around it, or a part's own h, when left out."
        },
        "after": {
          "$ref": "#/definitions/expression",
          "description": "In a column: how much further down the next one goes."
        },
        "hit": {
          "type": "string",
          "description": "A name for clicks. What is inside reads hot and pressed. It goes on top of what was drawn before it, after this node's own children."
        },
        "hit_index": {
          "$ref": "#/definitions/expression",
          "description": "Added to the id of hit. i in a repeat when left out."
        },
        "hit_by": {
          "$ref": "#/definitions/expression",
          "description": "The id of a click as a number, instead of hit, for a part: a screen gives it with hit('name'). Less than 0 is none."
        },
        "live": {
          "$ref": "#/definitions/expression",
          "description": "0: what is inside is never hot or pressed."
        },
        "hit_if": {
          "$ref": "#/definitions/expression",
          "description": "0: it takes no clicks."
        },
        "note": {
          "type": "string",
          "description": "Its box goes to the screen under this name."
        },
        "note_by": {
          "$ref": "#/definitions/expression",
          "description": "note as a number, for a part: a screen gives it with note('name'). Less than 0 is none."
        },
        "snap": {
          "type": "boolean",
          "description": "Its box moves to whole pixels."
        },
        "alpha": {
          "$ref": "#/definitions/expression",
          "description": "The colour's alpha, from 0 to 1, on fill, frame, stroke and text."
        },
        "fill": {
          "$ref": "#/definitions/expression",
          "description": "Fills its box with a Palette entry, plain or a gradient."
        },
        "radius": {
          "$ref": "#/definitions/expression",
          "description": "Rounds its corners."
        },
        "down_to": {
          "$ref": "#/definitions/expression",
          "description": "How far down from its top a gradient ends, instead of its height."
        },
        "across": {
          "type": "boolean",
          "description": "A gradient runs from left to right over its box, not downward. It takes no radius or down_to."
        },
        "frame": {
          "$ref": "#/definitions/expression",
          "description": "A line inside the edge of its box, in a Palette entry."
        },
        "stroke": {
          "$ref": "#/definitions/expression",
          "description": "A rounded line around its box, in a Palette entry."
        },
        "width": {
          "$ref": "#/definitions/expression",
          "description": "How thick its line is."
        },
        "line": {
          "$ref": "#/definitions/expression",
          "description": "A line in a Palette entry, from x, y to x2, y2."
        },
        "x2": {
          "$ref": "#/definitions/expression",
          "description": "Where it ends, from the left of the box around it."
        },
        "y2": {
          "$ref": "#/definitions/expression",
          "description": "Where it ends, from the top of the box around it."
        },
        "path": {
          "type": "string",
          "description": "SVG path data, drawn from x, y."
        },
        "color": {
          "$ref": "#/definitions/expression",
          "description": "A Palette entry, as $name."
        },
        "scale": {
          "$ref": "#/definitions/expression",
          "description": "Its size. 1 when left out."
        },
        "caps": {
          "enum": [
            "round",
            "flat"
          ],
          "description": "The ends of a stroke."
        },
        "soft": {
          "type": "boolean",
          "description": "Smooth edges under a Skin whose edges are whole pixels."
        },
        "text": {
          "type": "string",
          "description": "A text: #locale_key, @bound, or the words themselves."
        },
        "style": {
          "type": "string",
          "description": "A style of the pack."
        },
        "size": {
          "$ref": "#/definitions/expression",
          "description": "Instead of the style's, where it depends on the screen."
        },
        "line_height": {
          "$ref": "#/definitions/expression",
          "description": "Instead of the style's, where it depends on the screen."
        },
        "picture": {
          "type": "string",
          "description": "A picture the screen supplies."
        },
        "opacity": {
          "$ref": "#/definitions/expression",
          "description": "From 0 to 1."
        },
        "gray": {
          "$ref": "#/definitions/expression",
          "description": "How far it goes to gray, from 0 to 1."
        },
        "field": {
          "type": "string",
          "description": "A text field the screen owns."
        },
        "placeholder": {
          "type": "string",
          "description": "What it shows when empty."
        },
        "placeholder_color": {
          "$ref": "#/definitions/expression",
          "description": "A Palette entry, as $name."
        },
        "caret": {
          "$ref": "#/definitions/expression",
          "description": "A Palette entry, as $name."
        },
        "selection": {
          "$ref": "#/definitions/expression",
          "description": "A Palette entry, as $name."
        },
        "slot": {
          "type": "string",
          "description": "What only the screen can draw, in this box."
        },
        "numbers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/expression"
          },
          "maxItems": 8,
          "description": "Numbers for the screen, at most 8."
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "description": "Styles for the screen, at most 8."
        },
        "colors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/expression"
          },
          "maxItems": 8,
          "description": "Palette entries for the screen, at most 8."
        },
        "group": {
          "type": "array",
          "description": "A list of nodes inside this box."
        },
        "clip": {
          "type": "boolean",
          "description": "Nothing inside shows outside its box."
        },
        "column": {
          "type": "array",
          "description": "A list of nodes under each other: each goes at y = flow, and flow moves below it, by its after as well. Its height is what they took."
        },
        "use": {
          "type": "string",
          "description": "A part of pack.jsonc."
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/expression"
          },
          "description": "What the part's arguments are here."
        },
        "draw": {
          "type": "array",
          "description": "What goes where the part has a node {\"content\": true}."
        },
        "content": {
          "const": true,
          "description": "Where a part puts the draw list of whoever uses it."
        },
        "repeat": {
          "$ref": "#/definitions/expression",
          "description": "How many times its draw list runs."
        },
        "let": {
          "type": "string",
          "description": "A name for a number, for what comes after it and inside that."
        },
        "value": {
          "$ref": "#/definitions/expression",
          "description": "The number."
        },
        "set": {
          "type": "string",
          "description": "A new value for a name above it, as when a repeat looks for the widest."
        },
        "report": {
          "type": "string",
          "description": "A number for the screen."
        }
      },
      "anyOf": [
        {
          "required": [
            "fill"
          ],
          "propertyNames": {
            "enum": [
              "fill",
              "if",
              "id",
              "x",
              "right",
              "y",
              "bottom",
              "w",
              "h",
              "after",
              "hit",
              "hit_index",
              "hit_by",
              "live",
              "hit_if",
              "note",
              "note_by",
              "snap",
              "alpha",
              "radius",
              "down_to",
              "across"
            ]
          }
