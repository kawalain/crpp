{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The screen toast of a Skin Pack",
  "description": "A screen of a Skin Pack, as {\"draw\": [nodes]}. With no file for a screen, the program draws it itself.\nNumbers: @has_action, @up.\nTexts: @text, @action.\nHits: action.\nPictures: none.\nFields: none.\nSlots: none.\nReports: ms.\nNotes: none.",
  "allowComments": true,
  "allowTrailingCommas": true,
  "type": "object",
  "required": [
    "draw"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "draw": {
      "$ref": "#/definitions/nodes"
    }
  },
  "definitions": {
    "text": {
      "anyOf": [
        {
          "enum": [
            "@text",
            "@action"
          ]
        },
        {
          "$ref": "common.schema.json#/definitions/plain_text"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "node": {
      "allOf": [
        {
          "$ref": "common.schema.json#/definitions/node_shape"
        }
      ],
      "properties": {
        "hit": {
          "enum": [
            "action"
          ]
        },
        "note": false,
        "picture": false,
        "field": false,
        "slot": false,
        "report": {
          "enum": [
            "ms"
          ]
        },
        "text": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "$ref": "#/definitions/text"
        },
        "group": {
          "$ref": "#/definitions/nodes"
        },
        "column": {
          "$ref": "#/definitions/nodes"
        },
        "draw": {
          "$ref": "#/definitions/nodes"
        }
      }
    }
  }
}
