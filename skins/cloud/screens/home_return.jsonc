{
  "$schema": "../../schema/screen.home_return.schema.json",
  "draw": [
    {"let": "shown", "to": 1, "ms": 160},
    {"let": "card_w", "value": "min(320, W-40)"},
    {"let": "text_h", "value": "texth('modal_text', '#home_return_question', card_w-50)"},
    {"use": "modal", "args": {"card_w": "card_w", "card_h": "24+text_h+20+38+20", "shown": "shown", "backdrop": "hit('backdrop')", "card": "hit('card')"}, "draw": [
      {"text": "#home_return_question", "style": "modal_text", "color": "alpha($hl_text, shown)", "x": 25, "y": 24, "w": "W-50", "h": "text_h"},
      {"let": "confirm_w", "value": "max(96, textw('modal_button_measure', '#home_return', 400)+28)"},
      {"let": "random_w", "value": "max(96, textw('modal_button_measure', '#home_random', 400)+28)"},
      {"let": "left", "value": "(W-confirm_w-10-random_w)/2"},
      {"use": "modal_button", "text": "#home_return", "args": {"primary": 1, "shown": "shown", "hit": "hit('confirm')"}, "x": "left", "y": "H-58", "w": "confirm_w", "h": 38},
      {"use": "modal_button", "text": "#home_random", "args": {"shown": "shown", "hit": "hit('random')"}, "x": "left+confirm_w+10", "y": "H-58", "w": "random_w", "h": 38}
    ]}
  ]
}
