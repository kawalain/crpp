{
  "$schema": "../../schema/screen.update_popup.schema.json",
  "draw": [
    {"let": "pad_left", "value": 10},
    {"let": "pad_right", "value": 6},
    {"let": "pad_y", "value": 5},
    {"let": "label_w", "value": "@has_label ? textw('button', '@label')+24 : 0"},
    {"let": "chrome", "value": "pad_left+pad_right+(label_w>0 ? label_w+8 : 0)"},
    {"let": "room", "value": "max(40, W-16-chrome)"},
    {"let": "text_w", "value": "min(textw('body', '@text', room)+1, room)"},
    {"x": 8, "y": 8, "w": "text_w+chrome", "h": "(label_w>0 ? button_h : 22)+2*pad_y", "group": [
      {"use": "panel_info"},
      {"hit": "card", "group": []},
      {"text": "@text", "style": "body", "color": "$ink", "x": "pad_left", "y": "(H-22)/2", "w": "text_w", "h": 22},
      {"if": "label_w>0", "use": "button", "text": "@label", "hit": "button", "x": "W-pad_right-label_w", "y": "pad_y", "w": "label_w", "h": "button_h", "args": {"primary": 1}}
    ]}
  ]
}
