// Generated by apps/gui/CMakeLists.txt. crpp_build.h holds the product version, which
// names the commit and so changes without CMake running again.
#include <winver.h>
#include "crpp_build.h"

1 ICON "@CRPP_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @CRPP_VERSION_MAJOR@,@CRPP_VERSION_MINOR@,@CRPP_VERSION_PATCH@,0
PRODUCTVERSION @CRPP_VERSION_MAJOR@,@CRPP_VERSION_MINOR@,@CRPP_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041204B0"
    BEGIN
      VALUE "FileDescription", "Cloudroom++"
      VALUE "FileVersion", "@CRPP_VERSION@"
      VALUE "InternalName", "crpp"
      VALUE "LegalCopyright", L"\x00A9 2026 Lee Sangha"
      VALUE "OriginalFilename", "crpp.exe"
      VALUE "ProductName", "Cloudroom++"
      VALUE "ProductVersion", CRPP_PRODUCT_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0412, 1200
  END
END
