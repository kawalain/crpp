      "legend": "#5f7340",
      "select": "#93a070",
      "header": [[0, "#f2f4e4"], [1, "#d8dfbc"]],
      "info": [[0, "#eef1dc"], [1, "#d8dfbc"]],
      "info_line": "#a5ab80",
      "link": "#4b6a2e",
      "picture_line": "#a5ab80",
      "selection": "#93a07066",
      "minimize_down": "#5f7340"
    },
    "luna_homestead_dark": {
      "extends": "luna_blue_dark",
      "caption": [[0, "#6b7a4c"], [0.08, "#3c4a28"], [0.4, "#3c4a28"], [0.88, "#47562f"], [0.93, "#47562f"], [0.95, "#3c4a28"], [0.96, "#2a3519"], [1, "#2a3519"]],
      "caption_shadow": "#141a0a",
      "frame_out": "#2a3519",
      "frame_mid": "#47562f",
      "frame_in": "#3c4a28",
      "frame_low_out": "#1a2110",
