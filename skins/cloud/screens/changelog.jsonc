{
  "$schema": "../../schema/screen.changelog.schema.json",
  "draw": [
    {"let": "shown", "to": 1, "ms": 160},
    {"let": "card_w", "value": "min(520, W-40)"},
    {"let": "card_h", "value": "min(480, H-60)"},
    {"let": "ink", "value": "alpha($hl_text, shown)"},
    {"use": "modal", "args": {"card_w": "card_w", "card_h": "card_h", "shown": "shown", "backdrop_hit": "hit('backdrop')", "card_hit": "hit('card')"}, "draw": [
      // --cl-bg: color-mix(in srgb, var(--hl) 3%, var(--surface))
      {"fill": "alpha(mix($hl, $surface, 3), shown)", "radius": 14},
      {"let": "pad_x", "value": 28},
      {"let": "head_top", "value": 22},
      {"let": "head_w", "value": "W-pad_x-62"},
      {"let": "tagline_h", "value": "@has_tagline ? texth('note_title', '@tagline', head_w) : 0"},
      {"let": "date_h", "value": "@has_date ? texth('note_date', '@date', head_w) : 0"},
      {"let": "version_h", "value": "@has_version ? texth('note_version', '@version', head_w) : 0"},
      {"let": "date_y", "value": "head_top+(@has_tagline ? tagline_h+2 : 0)"},
      {"let": "version_y", "value": "date_y+(@has_date ? date_h+2 : 0)"},
      {"let": "head_end", "value": "version_y+(@has_version ? version_h : (@has_tagline || @has_date ? -2 : 0))"},
      {"let": "head_h", "value": "@has_tagline || @has_date || @has_version ? head_end+14 : 0"},
      {"if": "!@has_entries", "text": "#changelog_failed", "style": "note_failed", "color": "ink", "x": "pad_x", "y": "(H-27)/2", "w": "W-2*pad_x", "h": 27},
      {"slot": "body", "y": "head_h", "h": "H-head_h", "numbers": ["pad_x", 20, 4, 14, 6, 24, "head_h>0 ? 0 : head_top", "W"], "styles": ["note_heading", "note_item"], "colors": ["ink"]},
      {"if": "@has_tagline", "text": "@tagline", "style": "note_title", "color": "ink", "x": "pad_x", "y": "head_top", "w": "head_w", "h": "tagline_h"},
      {"if": "@has_date", "text": "@date", "style": "note_date", "color": "ink", "x": "pad_x", "y": "date_y", "w": "head_w", "h": "date_h"},
      {"if": "@has_version", "text": "@version", "style": "note_version", "color": "alpha($hl_text_soft, shown)", "x": "pad_x", "y": "version_y", "w": "head_w", "h": "version_h"},
      // .cl-close
      {"hit": "close", "x": "W-16-36", "y": 15, "w": 36, "h": 36, "group": [
        {"if": "hot", "fill": "alpha($hl_pale2, shown)", "ellipse": true},
        {"path": "M12 12 24 24M24 12 12 24", "color": "alpha($hl, shown)", "width": 4.4, "caps": "flat"}
      ]},
      // .cl-hint
      {"let": "hint", "to": "@hint_on", "ms": 180},
      {"report": "hint_left", "value": "hint"},
      {"if": "hint>0", "group": [
        {"let": "bubble_w", "value": "textw('note_hint', '@hint', W)+30"},
        {"let": "text_h", "value": "texth('note_hint', '@hint', W)"},
        {"x": "(W-bubble_w)/2", "y": "(@shown_hint<0 ? 14 : H-14-text_h-10)+4*(1-hint)", "w": "bubble_w", "h": "text_h+10", "group": [
          {"use": "bubble", "args": {"shown": "hint"}},
          {"text": "@hint", "style": "note_hint", "color": "alpha($on_accent, hint)", "y": 5, "h": "text_h"}
        ]}
      ]}
    ]}
  ]
}
