{
  "$schema": "../../schema/screen.prompt.schema.json",
  "draw": [
    // .setup-card
    {"let": "card_w", "value": "min(440, W*0.78)"},
    {"let": "inner", "value": "card_w-2*30"},
    {"let": "hint_h", "value": "max(24, texth('prompt_hint', '@hint', inner-8))"},
    {"let": "has_actions", "value": "@has_extra || @cancelable"},
    {"let": "card_h", "value": "28+26+(@has_heading ? 36+26 : 0)+(@has_label ? 22+10 : 0)+68+11+hint_h+(has_actions ? 14+36 : 0)+(@has_link ? 14+36 : 0)"},
    {"x": "(W-card_w)/2", "y": "(H-card_h)/2", "w": "card_w", "h": "card_h", "group": [
      {"use": "panel_list"},
      {"x": 30, "y": 28, "w": "inner", "column": [
        {"if": "@has_heading", "text": "@heading", "style": "prompt_heading", "color": "$hl_text", "h": 36, "after": 26},
        {"if": "@has_label", "text": "@label", "style": "prompt_label", "color": "$hl_text", "x": 4, "w": "W-4", "h": 22, "after": 10},

        // .setup-input-wrap: 20 of padding, then the text, the eye and the arrow.
        {"h": 68, "after": 11, "group": [
          {"fill": "$hl_pale", "radius": 16},
          {"hit": "field", "group": []},
          {"if": "@has_prefix", "text": "@prefix", "style": "prompt_input", "color": "$hl_text", "x": 20, "y": 5, "w": 40, "h": 58},
          {"let": "text_left", "value": "20+(@has_prefix ? textw('prompt_input', '@prefix', 40)+2 : 0)"},

          // The arrow: 44 square, lit when the value can go.
          {"let": "can", "value": "@valid && !@locked"},
          {"let": "faded", "value": "@busy || @locked ? 0.6 : 1"},
          {"hit": "submit", "live": "can && !@busy", "x": "W-12-44", "y": 12, "w": 44, "h": 44, "group": [
            {"if": "can", "fill": "alpha(hot ? $hl_dark : $hl, faded)", "radius": 13},
            {"path": "M10 22h23M23 11l11 11-11 11", "color": "alpha(can ? $on_accent : $hl_text_soft, faded)", "x": 7, "y": 7, "scale": "30/44", "width": 3}
          ]},
          {"let": "text_right", "value": "W-12-44-(@password ? 40 : 0)"},
          {"if": "@password", "hit": "eye", "x": "text_right", "y": 16, "w": 36, "h": 36, "group": [
            {"if": "hot", "fill": "$hl_pale2", "radius": 10},
            {"path": "M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z", "color": "$hl_text", "x": 7, "y": 7, "scale": "22/24", "width": 2},
            {"x": 7, "y": 7, "w": 24, "h": 24, "scale": "22/24", "about_x": 7, "about_y": 7, "group": [
              {"stroke": "$hl_text", "ellipse": true, "x": 9, "y": 9, "w": 6, "h": 6, "width": 2}
            ]},
            {"if": "@shown", "path": "M4 4l16 16", "color": "$hl_text", "x": 7, "y": 7, "scale": "22/24", "width": 2}
          ]},

          // The input, scrolled sideways so the caret stays in view.
          {"slot": "field", "styles": ["prompt_input"], "colors": ["$hl_text", "$hl_text_soft", "$hl_text", "alpha($hl, 0.4)", "$hl_pale"], "x": "text_left", "y": 5, "w": "text_right-8-text_left", "h": 58}
        ]},

        // .setup-hint
        {"text": "@hint", "style": "prompt_hint", "color": "@hint_error ? $error_text : $hint_ink", "x": 4, "w": "W-8", "h": "hint_h"},

        {"let": "back_w", "value": "textw('prompt_button', '#prompt_back', W)+32"},
        {"let": "extra_w", "value": "@has_extra ? textw('prompt_button', '@extra', W)+32 : 0"},
        {"let": "extra2_w", "value": "@has_extra2 ? textw('prompt_button', '@extra2', W)+32 : 0"},
        {"let": "link_w", "value": "@has_link ? textw('prompt_button', '@link', W)+32 : 0"},
        {"if": "has_actions", "y": "flow+14", "h": 36, "group": [
          {"if": "@cancelable", "use": "prompt_button", "text": "#prompt_back", "hit": "back", "live": "!@busy", "w": "back_w"},
          {"if": "@has_extra && @has_extra2", "use": "prompt_button", "text": "@extra2", "hit": "extra2", "live": "!@busy", "x": "W-extra2_w", "w": "extra2_w"},
          {"if": "@has_extra", "use": "prompt_button", "text": "@extra", "hit": "extra", "live": "!@busy", "x": "W-(@has_extra2 ? extra2_w+10 : 0)-extra_w", "w": "extra_w"}
        ]},
        {"if": "@has_link", "use": "prompt_button", "text": "@link", "hit": "link", "live": "!@busy", "x": "(W-link_w)/2", "y": "flow+14", "w": "link_w", "h": 36}
      ]}
    ]}
  ]
}
