      "caption": [[0, "#bccb97"], [0.08, "#8ba169"], [0.4, "#8ba169"], [0.88, "#9bb078"], [0.93, "#9bb078"], [0.95, "#8ba169"], [0.96, "#6f8550"], [1, "#6f8550"]],
      "caption_idle": [[0, "#e6e8d6"], [0.08, "#d4d6ba"], [0.4, "#d4d6ba"], [0.88, "#dcdec6"], [0.93, "#dcdec6"], [0.95, "#d4d6ba"], [0.96, "#c2c4a6"], [1, "#c2c4a6"]],
