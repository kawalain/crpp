{
  "$schema": "../../schema/screen.settings_account.schema.json",
  "draw": [
    {"text": "#account_heading", "style": "heading", "color": "$hl_text", "x": 9, "y": 25, "w": 400, "h": 32},
    // .profile: the icon and the names beside it.
    {"hit": "emoji", "x": 16, "y": 76, "w": 72, "h": 72, "group": [
      {"scale": "hot ? 1.05 : 1", "group": [
        {"fill": "hot ? $hl_pale2 : $hl_pale", "ellipse": true},
        {"picture": "me", "x": 13, "y": 13, "w": 46, "h": 46}
      ]},
      {"if": "hot", "x": "36-112/2", "y": "-8-32", "w": 112, "h": 32, "group": [
        {"fill": "$hl", "radius": 11},
        {"text": "#profile_change_icon", "style": "account_tip", "color": "$on_accent", "y": 5, "h": 22}
      ]}
    ]},
    {"if": "@has_names", "text": "@nickname", "style": "account_nickname", "color": "$hl_text", "x": 106, "y": 86, "w": 428, "h": 30},
    {"if": "@has_names", "text": "@handle", "style": "account_handle", "color": "$hl_text_soft", "x": 106, "y": 118, "w": 428, "h": 20},
    {"if": "!@has_names", "text": "@display", "style": "account_display", "color": "$hl_text", "x": 106, "y": 95, "w": 428, "h": 34},
    {"use": "account_button", "text": "#account_change_nickname", "hit": "nickname", "x": 16, "y": 165, "w": 154, "h": 38},
    {"if": "@has_account", "use": "account_button", "text": "#account_change_handle", "hit": "change_handle", "x": 182, "y": 165, "w": 154, "h": 38},
    {"use": "account_button", "text": "#account_logout", "hit": "logout", "x": 380, "y": 440, "w": 154, "h": 38},
    {"report": "height", "value": "440+38+25"}
  ]
}
