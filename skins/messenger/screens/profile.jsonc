{
  "$schema": "../../schema/screen.profile.schema.json",
  "draw": [
    {"let": "pad_top", "value": 24},
    {"let": "pad_x", "value": 25},
    {"let": "icon_size", "value": 72},
    {"let": "stat_y", "value": "pad_top+icon_size+20"},
    {"let": "stat", "value": "17*1.9"},
    {"let": "names_x", "value": "pad_x+icon_size+18"},
    {"report": "width", "value": 380},
    {"report": "height", "value": "stat_y+(@has_joined ? 3 : 2)*stat+20"},
    {"hit": "card", "group": []},
    {"hit": "icon", "hit_if": "@mine", "note": "icon", "x": "pad_x", "y": "pad_top", "w": "icon_size", "h": "icon_size", "group": [
      {"use": "picture_frame", "args": {"glow": "hot"}},
      {"let": "emoji", "value": "hot ? 46*1.05 : 46"},
      {"picture": "icon", "x": "(W-emoji)/2", "y": "(H-emoji)/2", "w": "emoji", "h": "emoji"}
    ]},
    {"if": "@has_handle", "text": "@nick", "style": "title", "color": "$ink", "x": "names_x", "y": "pad_top+10", "w": "W-pad_x-names_x", "h": 30},
    {"if": "@has_handle", "text": "@handle", "style": "body", "color": "$ink_soft", "x": "names_x", "y": "pad_top+42", "w": "W-pad_x-names_x", "h": 20},
    {"if": "!@has_handle", "text": "@nick", "style": "title", "color": "$ink", "x": "names_x", "y": "pad_top+19", "w": "W-pad_x-names_x", "h": 34},
    {"if": "@has_joined", "text": "@joined", "style": "body", "color": "$ink", "x": "pad_x", "y": "stat_y", "w": "W-2*pad_x", "h": "stat"},
    {"text": "@stayed", "style": "body", "color": "$ink", "x": "pad_x", "y": "stat_y+(@has_joined ? stat : 0)", "w": "W-2*pad_x", "h": "stat"},
    {"text": "@inputs", "style": "body", "color": "$ink", "x": "pad_x", "y": "stat_y+(@has_joined ? 2 : 1)*stat", "w": "W-2*pad_x", "h": "stat"}
  ]
}
