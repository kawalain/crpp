{
  "$schema": "../../schema/screen.bubble.schema.json",
  "draw": [
    // .btn-notice: its right edge meets the button's, and it rises 4 px as it fades in.
    {"report": "ms", "value": 150},
    {"let": "shown", "to": "@up", "again": "@again", "ms": 150},
    {"let": "text_w", "value": "textw('bubble_text', '@text', 420-30)"},
    {"let": "text_h", "value": "texth('bubble_text', '@text', 420-30)"},
    {"let": "box_w", "value": "text_w+30"},
    {"let": "box_h", "value": "text_h+10"},
    {"x": "@anchor_right-box_w", "y": "@anchor_y-@gap-box_h+4*(1-shown)", "w": "box_w", "h": "box_h", "group": [
      {"fill": "alpha($hl, shown)", "radius": 11},
      {"text": "@text", "style": "bubble_text", "color": "alpha($on_accent, shown)", "x": 15, "y": 5, "w": "W-30+1", "h": "text_h"}
    ]}
  ]
}
